{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cncdt.local/schemas/cnc.control.v1.json",
  "title": "cnc.control.v1",
  "description": "Mesaje de control între cloud și simulare. Comenzile de operator merg în sensul cloud către simulare (coada SQS, apoi topicul de comandă). Verdictul de inspecție merge tot dinspre cloud, dar are prioritate: acționează pistonul de rejecție.",
  "oneOf": [
    {
      "title": "Comandă de operator",
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "inject_tool_wear",
            "inject_joint_friction",
            "force_defect",
            "replace_tool",
            "repair_joints",
            "set_defect_probability",
            "pause",
            "resume",
            "start_cycle",
            "stop_cycle",
            "reset"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cât se adaugă la indicele de degradare, pentru comenzile de injectare."
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Valoarea nouă, pentru set_defect_probability."
        }
      }
    },
    {
      "title": "Verdict de inspecție",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "part_id"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "REJECT", "FAIL", "DEFECT"]
        },
        "part_id": { "type": "string" },
        "cycle_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" },
        "model_version": { "type": "string" }
      }
    }
  ]
}
