EBS_GP3_IOPS_MONTH="0.006"
EBS_GP3_MIBPS_MONTH="0.0476"
EBS_SNAPSHOT_GB_MONTH="0.054"
PUBLIC_IPV4_HOUR="0.005"
GP3_FREE_IOPS="3000"
GP3_FREE_MIBPS="125"

instance_hourly_rate() {
  case "$1" in
    g5.xlarge)    echo "1.006" ;;
    g5.2xlarge)   echo "1.5156" ;;
    g5.4xlarge)   echo "1.624" ;;
    g5.8xlarge)   echo "2.448" ;;
    g5.12xlarge)  echo "5.672" ;;
    g5.16xlarge)  echo "4.288" ;;
    g5.24xlarge)  echo "8.144" ;;
    g5.48xlarge)  echo "16.288" ;;
    g6.xlarge)    echo "0.805" ;;
    g6.2xlarge)   echo "1.323" ;;
    g6.4xlarge)   echo "1.861" ;;
    g6e.xlarge)   echo "1.861" ;;
    g4dn.xlarge)  echo "0.526" ;;
    g4dn.2xlarge) echo "0.752" ;;
    g4dn.4xlarge) echo "1.204" ;;
    g4dn.12xlarge) echo "3.912" ;;
    *)            echo "" ;;
  esac
}

# Prețul spot curent pentru un tip de instanță, cel mai recent punct publicat de AWS.
# `describe-spot-price-history` cere un început de interval; șase ore în urmă este suficient
# ca fiecare zonă să aibă un punct, iar dintre puncte îl luăm pe cel mai nou.
spot_hourly_rate() {
  local itype="$1" start
  start="$(date -u -v-6H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -d '6 hours ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  [[ -z "${start}" ]] && return 0

  aws_cli ec2 describe-spot-price-history \
    --instance-types "${itype}" \
    --product-descriptions "Linux/UNIX" \
    --start-time "${start}" \
    --query 'reverse(sort_by(SpotPriceHistory,&Timestamp))[0].SpotPrice' \
    --output text 2>/dev/null || true
}

# Tipul de piață al instanței: `spot` sau on-demand (câmpul `InstanceLifecycle` e gol).
instance_market() {
  local lifecycle
  lifecycle="$(instance_field "${1}" "InstanceLifecycle")"
  if [[ "${lifecycle}" == "spot" ]]; then
    printf 'spot'
  else
    printf 'on-demand'
  fi
}

# Tariful orar aplicabil: prețul spot publicat acum, dacă instanța e pe spot, altfel tariful
# on-demand din tabelul de mai sus. Prețul spot se citește la fiecare rulare, deci estimarea
# urmează piața, iar când citirea eșuează se cade înapoi pe on-demand.
hourly_rate_for() {
  local id="$1" itype="$2" rate=""
  if [[ "$(instance_market "${id}")" == "spot" ]]; then
    rate="$(spot_hourly_rate "${itype}")"
    if [[ -n "${rate}" && "${rate}" != "None" ]]; then
      awk -v r="${rate}" 'BEGIN { printf "%.4f", r }'
      return 0
    fi
  fi
  instance_hourly_rate "${itype}"
}

# ---------------------------------------------------------------- ieșire
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""
fi

info()  { printf '%s\n' "${C_BLUE}==>${C_RESET} $*"; }
ok()    { printf '%s\n' "${C_GREEN} ok ${C_RESET} $*"; }
warn()  { printf '%s\n' "${C_YELLOW}atenție${C_RESET} $*" >&2; }
die()   { printf '%s\n' "${C_RED}eroare${C_RESET} $*" >&2; exit 1; }
plain() { printf '%s\n' "$*"; }

row() {
  # Aliniază eticheta la `width` caractere vizibile (diacriticele ocupă un caracter).
  local label="$1" value="${2:-}" width="${3:-18}"
  local pad=$(( width - ${#label} ))
  (( pad < 1 )) && pad=1
  printf '  %s%*s%s\n' "${label}" "${pad}" "" "${value}"
}

usage() {
  cat <<'EOF'
twinctl — ciclul de viață al instanței NVIDIA Isaac Sim, dintr-o singură comandă.

  ./tools/twinctl/twinctl init       verificări prealabile, cheie SSH, bucket de asset-uri
  ./tools/twinctl/twinctl up         creează instanța GPU și afișează datele de conectare
  ./tools/twinctl/twinctl status     starea instanței și datele de conectare
  ./tools/twinctl/twinctl connect    deschide tunelul și afișează URL-ul clientului WebRTC
  ./tools/twinctl/twinctl stop       oprește instanța (păstrează discul)
  ./tools/twinctl/twinctl data       starea volumului EBS persistent de date
  ./tools/twinctl/twinctl down       șterge resursele de simulare (volumul de date rămâne)

Toate operațiunile trec prin Terraform (`infra/terraform/stacks/sim` și `stacks/sim-data`,
state local) și prin AWS CLI pentru acțiuni de runtime. Nu se folosește consola AWS.

Instanța rulează pe piața spot (`SIM_USE_SPOT=true`): costă aproximativ jumătate, iar la o
întrerupere AWS anunță cu două minute și termină instanța, fără să repornească nimic automat.
Când AWS nu are capacitate, `up` eșuează cu un indiciu; nu există revenire pe on-demand.
Revenirea este o decizie explicită: `make sim-up` creează o instanță nouă și reatașează
volumul de date persistent. AWS acceptă oprirea doar pentru cererile spot `persistent`, iar
cererea de aici este `one-time`, deci pe spot `stop` refuză și trimite la `down` urmat de `up`;
on-demand (`SIM_USE_SPOT=false`) se oprește și se pornește normal. Detalii:
docs/adr/0010-instanta-de-simulare-pe-spot.md.

Comenzi:
  init                 Verifică uneltele, creează cheia SSH și bucket-ul de asset-uri
  up [opțiuni]         Creează instanța GPU și afișează datele de conectare
                       (--wait așteaptă finalizarea bootstrap-ului)
  status [--deep]      Starea instanței, datele de conectare; --deep rulează autotestarea
  url                  Afișează serverul de semnalizare al clientului WebRTC
  connect [opțiuni]    Deschide tunelul de semnalizare WebRTC (--mode auto|ssm|ssh, --stop închide)
  dcv [--open]         Datele de acces grafic (desktop GNOME + Amazon DCV); --open deschide tunelul
  ssh [comandă...]     Shell sau comandă pe instanță, prin SSM sau SSH
  assets               Starea oglinzii locale de conținut Isaac Sim; pornește sincronizarea
                       dacă lipsește (fără ea, browserele de asset-uri rămân goale)
  push                 Urcă simulation/ pe instanță, prin S3 și SSM (cere bucket)
  push-sim             Urcă simulation/ direct prin SSH (fără S3), pentru codul extensiei
  vpn-config           Scrie profilul .ovpn (certificat de client inclus) pentru AWS VPN Client
  vpn-off | vpn-on     Șterge ori recreează endpoint-ul Client VPN, fără să atingă instanța.
                       Endpoint-ul se taxează orar cât timp există, conectat sau nu.
  logs [--follow]      Afișează logurile Isaac Sim
  start | stop         Pornește instanța (cere comutatorul de lansare) ori o oprește, păstrând
                       discul
  freeze [opțiuni]     Creează un AMI din instanță ca să nu reinstalezi Isaac Sim la următoarea
                       pornire (--list, --keep N șterge AMI-urile mai vechi, --clear renunță)
  data                 Starea volumului de date: ID, zonă, dimensiune, instanța care îl are,
                       snapshot-uri existente și costul lunar
  data-up [--snapshot ID] [--fresh]
                       Creează volumul de date dacă lipsește (altfel nu face nimic). Dacă
                       lipsește, reia automat ultimul snapshot; --snapshot impune un altul, iar
                       --fresh cere un volum gol, fără snapshot
  data-down [--yes] [--no-snapshot]
                       ȘTERGE volumul de date. Implicit face întâi un snapshot; --no-snapshot
                       șterge fără copie nouă (snapshot-urile vechi rămân). Cere volumul
                       detașat (întâi `make sim-down`)
  data-snapshot [--list] [--keep N]
                       Creează un snapshot al volumului; --list le afișează pe cele existente,
                       --keep N le șterge pe cele mai vechi peste N (merge și fără volum)
  selftest             Rulează diagnoza mediului pe instanță
  outputs              Afișează toate ieșirile Terraform
  cost                 Estimare de cost pentru starea curentă
  spot                 Prețul spot pe zone, comparația cu on-demand și scorul de capacitate
  down [--yes] [--freeze]
                       Șterge resursele de simulare (instanță, disc rădăcină, cheie, VPN).
                       Volumul de date NU se șterge: rămâne pentru următoarea instanță și se
                       șterge doar cu `data-down`. --freeze face întâi un AMI golden

Ciclul economic recomandat:
  make sim-up          pornește din AMI-ul golden, dacă există
  make sim-freeze      salvează starea instalată într-un AMI (explicit, când vrei)
  make sim-down        șterge instanța; rămân AMI-ul golden și volumul de date
  make sim-data        arată volumul de date persistent
  make sim-vpn         scrie profilul AWS VPN Client și arată adresa de streaming din tunel

Volumul de date (SIM_DATA_VOLUME_ENABLED=true) este un EBS separat care se atașează fiecărei
instanțe și se montează la /opt/cncdt: asset-urile, cache-ul și simulările supraviețuiesc
instanței spot. Se șterge doar cu `data-down`, iar snapshot-urile se fac doar cu
`data-snapshot`. Dacă volumul lipsește (a fost șters), `up` îl recreează în aceeași zonă și
reia automat ultimul snapshot; `SIM_DATA_VOLUME_SNAPSHOT` din .env, ori `data-up --snapshot`,
impune alt snapshot, iar `data-up --fresh` cere un volum gol. Se plătește lunar cât timp
există. Detalii: docs/adr/0011-volum-de-date-persistent.md.

Comutatorul de lansare (INFRA_LAUNCH_ENABLED, implicit false, citit din .env) blochează
comenzile care creează, extind sau repornesc resurse plătite: up, start, data-up și vpn-on.
Fără el rămân neatinse citirea (status, cost, data, spot, outputs, logs) și ștergerea ori
oprirea (down, data-down, vpn-off, stop). Detalii: ops/runbooks/launch-guard.md

Variabile de mediu (citite din .env dacă există):
  INFRA_LAUNCH_ENABLED, AWS_PROFILE, AWS_REGION, PROJECT_NAME, ENVIRONMENT, SIM_INSTANCE_TYPE,
  SIM_USE_SPOT,
  SIM_ROOT_VOLUME_GB, SIM_ROOT_VOLUME_IOPS, SIM_ROOT_VOLUME_THROUGHPUT, SIM_ALLOCATE_EIP,
  SIM_AUTOSTART, SIM_ISAAC_SIM_IMAGE, SIM_AMI_ID, SIM_GOLDEN_AMI_PREFIX,
  SIM_INSTALL_CLOUDWATCH_AGENT, SIM_WEBRTC_PUBLIC_PORTS, SIM_ASSETS_BUCKET,
  SIM_SSH_KEY_NAME, SIM_SSH_PUBLIC_KEY, SIM_SSH_PRIVATE_KEY, SIM_SSH_ALLOWED_CIDRS,
  SIM_ENABLE_TURN, ISAAC_SIGNALING_PORT, ISAAC_STREAM_PORT,
  SIM_ISAAC_CONTENT_SECTIONS, SIM_ISAAC_CONTENT_URL,
  SIM_DATA_VOLUME_ENABLED, SIM_DATA_VOLUME_GB, SIM_DATA_VOLUME_IOPS,
  SIM_DATA_VOLUME_THROUGHPUT, SIM_DATA_VOLUME_AZ, SIM_DATA_VOLUME_SNAPSHOT,
  SIM_VPN_ENABLED, SIM_VPN_CLIENT_CIDR, SIM_VPN_PORT, SIM_VPN_TRANSPORT, SIM_VPN_CLIENT_CN
EOF
}

# ---------------------------------------------------------------- utilitare
require_cmd() {
  local cmd="$1" hint="${2:-}"
  command -v "${cmd}" >/dev/null 2>&1 || die "lipsește comanda \`${cmd}\`.${hint:+ $hint}"
}

# Comutatorul de lansare: orice comandă care creează sau extinde o resursă plătită trece întâi
# pe aici. Implicit `false` (`INFRA_LAUNCH_ENABLED` în `.env`), ca o rulare din greșeală să nu
# poată porni instanța GPU, volumul EBS ori endpoint-ul Client VPN. Verificarea e locală și se
# face înainte de orice apel la AWS, iar mesajul spune exact ce trebuie pus în `.env`.
# Ștergerea nu trece niciodată pe aici: teardown-ul rămâne mereu permis.
require_launch_enabled() {
  local action="$1" retry="$2"
  [[ "${INFRA_LAUNCH_ENABLED:-false}" == "true" ]] && return 0

  {
    printf '%s\n' "${C_RED}refuz${C_RESET}: ${action} nu pornește (comutatorul de lansare este oprit)."
    plain ""
    plain "  INFRA_LAUNCH_ENABLED este „${INFRA_LAUNCH_ENABLED:-<nesetat>}” în .env, iar implicit este „false”."
    plain "  Refuzul este deliberat și se decide local, înainte de orice apel la AWS: nu este o"
    plain "  eroare de credențiale, de profil sau de rețea."
    plain ""
    plain "  Ca să lansezi deliberat, pune în .env:"
    plain "        INFRA_LAUNCH_ENABLED=true"
    plain "  apoi repetă comanda:"
    plain "        ${retry}"
    plain ""
    plain "  Fără comutator rămân permise: down, data-down, vpn-off, stop (șterg ori opresc), precum"
    plain "  și status, cost, data, spot, outputs, logs, freeze (citesc ori salvează)."
    plain "  Detalii: ops/runbooks/launch-guard.md"
  } >&2
  exit 1
}

load_env() {
  if [[ -f "${ROOT}/.env" ]]; then
    # Toate valorile din .env devin variabile de mediu pentru procesele copil.
    set -a
    # shellcheck source=/dev/null
    source "${ROOT}/.env"
    set +a
  fi

  # Comutatorul de lansare, citit din `.env` (implicit `false`). Orice comandă care creează sau
  # extinde o resursă plătită refuză înainte de a atinge AWS; căile de ștergere nu depind de el.
  INFRA_LAUNCH_ENABLED="${INFRA_LAUNCH_ENABLED:-false}"

  export AWS_PROFILE="${AWS_PROFILE:-default}"
  export AWS_REGION="${AWS_REGION:-us-east-1}"
  export PROJECT_NAME="${PROJECT_NAME:-cncdt}"
  export ENVIRONMENT="${ENVIRONMENT:-dev}"

  SIM_INSTANCE_TYPE="${SIM_INSTANCE_TYPE:-g5.2xlarge}"
  SIM_USE_SPOT="${SIM_USE_SPOT:-true}"
  SIM_ROOT_VOLUME_GB="${SIM_ROOT_VOLUME_GB:-200}"
  SIM_ROOT_VOLUME_IOPS="${SIM_ROOT_VOLUME_IOPS:-3000}"
  SIM_ROOT_VOLUME_THROUGHPUT="${SIM_ROOT_VOLUME_THROUGHPUT:-125}"
  SIM_ALLOCATE_EIP="${SIM_ALLOCATE_EIP:-false}"
  SIM_AUTOSTART="${SIM_AUTOSTART:-false}"
  SIM_SSH_ALLOWED_CIDRS="${SIM_SSH_ALLOWED_CIDRS:-auto}"
  SIM_SSH_KEY_NAME="${SIM_SSH_KEY_NAME:-}"
  SIM_SSH_PUBLIC_KEY="${SIM_SSH_PUBLIC_KEY:-$HOME/.ssh/cncdt-sim.pub}"
  SIM_SSH_PRIVATE_KEY="${SIM_SSH_PRIVATE_KEY:-$HOME/.ssh/cncdt-sim}"
  SIM_ASSETS_BUCKET="${SIM_ASSETS_BUCKET:-}"
  SIM_AMI_ID="${SIM_AMI_ID:-}"
  SIM_GOLDEN_AMI_PREFIX="${SIM_GOLDEN_AMI_PREFIX:-${PROJECT_NAME}-${ENVIRONMENT}-sim-golden}"
  SIM_ENABLE_TURN="${SIM_ENABLE_TURN:-false}"
  SIM_INSTALL_CLOUDWATCH_AGENT="${SIM_INSTALL_CLOUDWATCH_AGENT:-true}"
  SIM_DCV_ENABLED="${SIM_DCV_ENABLED:-true}"
  SIM_DCV_PORT="${SIM_DCV_PORT:-8443}"
  SIM_DCV_PUBLIC_ACCESS="${SIM_DCV_PUBLIC_ACCESS:-false}"
  SIM_WEBRTC_PUBLIC_PORTS="${SIM_WEBRTC_PUBLIC_PORTS:-false}"
  SIM_VPN_ENABLED="${SIM_VPN_ENABLED:-false}"
  SIM_VPN_CLIENT_CIDR="${SIM_VPN_CLIENT_CIDR:-10.100.0.0/22}"
  SIM_VPN_PORT="${SIM_VPN_PORT:-443}"
  SIM_VPN_TRANSPORT="${SIM_VPN_TRANSPORT:-udp}"
  SIM_VPN_CLIENT_CN="${SIM_VPN_CLIENT_CN:-operator}"
  SIM_ISAAC_SIM_IMAGE="${SIM_ISAAC_SIM_IMAGE:-nvcr.io/nvidia/isaac-sim:latest}"
  SIM_ISAAC_CONTENT_SECTIONS="${SIM_ISAAC_CONTENT_SECTIONS:-Robots,Props,Materials,Sensors,Environments/Simple_Warehouse}"
  SIM_ISAAC_CONTENT_URL="${SIM_ISAAC_CONTENT_URL:-https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.0}"
  ISAAC_SIGNALING_PORT="${ISAAC_SIGNALING_PORT:-8211}"
  ISAAC_STREAM_PORT="${ISAAC_STREAM_PORT:-49100}"

  # Volumul EBS persistent care se atașează instanței și se montează la /opt/cncdt. Zona se
  # scrie o singură dată, la creare: un volum EBS aparține unei singure zone, iar instanța
  # trebuie să pornească exact acolo.
  SIM_DATA_VOLUME_ENABLED="${SIM_DATA_VOLUME_ENABLED:-true}"
  SIM_DATA_VOLUME_GB="${SIM_DATA_VOLUME_GB:-100}"
  SIM_DATA_VOLUME_IOPS="${SIM_DATA_VOLUME_IOPS:-3000}"
  SIM_DATA_VOLUME_THROUGHPUT="${SIM_DATA_VOLUME_THROUGHPUT:-125}"
  SIM_DATA_VOLUME_AZ="${SIM_DATA_VOLUME_AZ:-}"
  SIM_DATA_VOLUME_SNAPSHOT="${SIM_DATA_VOLUME_SNAPSHOT:-}"

  # O cheie existentă în AWS are prioritate față de generarea unei chei locale.

  mkdir -p "${STATE_DIR}" "${TUNNEL_DIR}"
}

has_ssm_plugin() {
  command -v session-manager-plugin >/dev/null 2>&1
}

aws_cli() {
  # Credențialele din mediu poartă sesiunea rolului de operator. Un `--profile` explicit le-ar
  # ignora și ar atribui acțiunile utilizatorului, deci îl trecem doar când ele lipsesc.
  if [[ -n "${AWS_ACCESS_KEY_ID:-}" ]]; then
    aws --region "${AWS_REGION}" "$@"
  elif [[ -n "${AWS_PROFILE:-}" ]]; then
    aws --region "${AWS_REGION}" --profile "${AWS_PROFILE}" "$@"
  else
    aws --region "${AWS_REGION}" "$@"
  fi
}

tf() {
  terraform -chdir="${TF_DIR}" "$@"
}

tfvar_list() {
  # Transformă "a,b,c" în lista HCL ["a", "b", "c"].
  local raw="$1"
  local IFS=','
  local out="" item
  for item in ${raw}; do
    item="${item// /}"
    [[ -z "${item}" ]] && continue
    out+="\"${item}\", "
  done
  printf '[%s]' "${out%, }"
}

generate_tfvars() {
  # Instanța trebuie să pornească în zona volumului de date, altfel nu îl poate atașa.
  local volume_id="" data_az=""
  if [[ "${SIM_DATA_VOLUME_ENABLED}" == "true" ]]; then
    volume_id="$(data_volume_id)"
    [[ -n "${volume_id}" ]] && data_az="$(data_volume_az)"
  fi

  info "generez ${TFVARS#"${ROOT}/"} din .env"
  cat > "${TFVARS}" <<EOF
# Generat automat de tools/twinctl. Nu editați manual: suprascris la fiecare rulare.
project_name = "${PROJECT_NAME}"
environment  = "${ENVIRONMENT}"
region       = "${AWS_REGION}"

instance_type          = "${SIM_INSTANCE_TYPE}"
use_spot               = ${SIM_USE_SPOT}
root_volume_size_gb    = ${SIM_ROOT_VOLUME_GB}
root_volume_iops       = ${SIM_ROOT_VOLUME_IOPS}
root_volume_throughput = ${SIM_ROOT_VOLUME_THROUGHPUT}
allocate_eip           = ${SIM_ALLOCATE_EIP}
ami_id                 = "${SIM_AMI_ID}"

availability_zone = "${data_az}"
data_volume_id    = "${volume_id}"

ssh_key_name            = "${SIM_SSH_KEY_NAME}"
ssh_key_public_key_path = "${SIM_SSH_PUBLIC_KEY}"
ssh_allowed_cidrs       = $(tfvar_list "${SIM_SSH_ALLOWED_CIDRS}")

signaling_port   = ${ISAAC_SIGNALING_PORT}
stream_port      = ${ISAAC_STREAM_PORT}
media_port_range = "${ISAAC_MEDIA_PORT_RANGE:-47998-48020}"
autostart_sim    = ${SIM_AUTOSTART}
enable_turn      = ${SIM_ENABLE_TURN}

isaac_sim_image          = "${SIM_ISAAC_SIM_IMAGE}"
isaac_content_sections   = $(tfvar_list "${SIM_ISAAC_CONTENT_SECTIONS}")
isaac_content_url        = "${SIM_ISAAC_CONTENT_URL}"
install_cloudwatch_agent = ${SIM_INSTALL_CLOUDWATCH_AGENT}
enable_dcv               = ${SIM_DCV_ENABLED}
dcv_port                 = ${SIM_DCV_PORT}
dcv_public_access        = ${SIM_DCV_PUBLIC_ACCESS}
webrtc_public_ports      = ${SIM_WEBRTC_PUBLIC_PORTS}

assets_bucket_name    = "${SIM_ASSETS_BUCKET}"
data_lake_bucket_arns = []

vpn_enabled            = ${SIM_VPN_ENABLED}
vpn_client_cidr_block  = "${SIM_VPN_CLIENT_CIDR}"
vpn_port               = ${SIM_VPN_PORT}
vpn_transport_protocol = "${SIM_VPN_TRANSPORT}"
vpn_client_common_name = "${SIM_VPN_CLIENT_CN}"
EOF
}

tf_ready() {
  [[ -d "${TF_DIR}/.terraform" ]]
}

ensure_tf_ready() {
  if ! tf_ready; then
    info "inițializez Terraform în stacks/sim"
    tf init -input=false >/dev/null || die "terraform init a eșuat"
  fi
}

tf_out() {
  local name="$1"
  tf output -raw "${name}" 2>/dev/null || true
}

tf_json() {
  tf output -json 2>/dev/null || echo '{}'
}

# ---------------------------------------------------------------- volumul de date
# Volumul stă în stack-ul `sim-data`, cu state separat: `sim-down` nu îl poate atinge, iar
# ștergerea lui trece exclusiv prin `data-down`.
data_tf() { terraform -chdir="${DATA_DIR}" "$@"; }

data_tf_out() {
  [[ -d "${DATA_DIR}/.terraform" ]] || return 0
  data_tf output -raw "$1" 2>/dev/null || true
}

data_volume_id() { data_tf_out volume_id; }
data_volume_az() { data_tf_out availability_zone; }

ensure_data_ready() {
  [[ -d "${DATA_DIR}/.terraform" ]] && return 0
  info "inițializez Terraform în stacks/sim-data"
  data_tf init -input=false >/dev/null || die "terraform init a eșuat în stacks/sim-data"
}

# Cea mai ieftină zonă pentru tipul de instanță, după ultimul preț spot publicat în fiecare
# zonă. Volumul se leagă de zona aleasă, iar instanța pornește în ea. Alternativa (o zonă
# aleasă manual) se pune în SIM_DATA_VOLUME_AZ înainte de prima creare.
cheapest_spot_az() {
  local start
  start="$(date -u -v-6H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -d '6 hours ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  local -a args=(
    ec2 describe-spot-price-history
    --instance-types "${SIM_INSTANCE_TYPE}"
    --product-descriptions "Linux/UNIX"
    --query 'reverse(sort_by(SpotPriceHistory,&Timestamp))[].[AvailabilityZone,SpotPrice]'
    --output text
  )
  [[ -n "${start}" ]] && args+=(--start-time "${start}")
  aws_cli "${args[@]}" 2>/dev/null \
    | awk '!vazut[$1]++ { print $1, $2 }' \
    | sort -k2 -n | awk 'NR == 1 { print $1 }'
}

generate_data_tfvars() {
  [[ -n "${SIM_DATA_VOLUME_AZ}" ]] || die "lipsește zona volumului; rulați \`make sim-data-up\`"
  info "generez ${DATA_TFVARS#"${ROOT}/"}"
  cat > "${DATA_TFVARS}" <<EOF
# Generat automat de tools/twinctl. Nu editați manual: suprascris la fiecare rulare.
project_name      = "${PROJECT_NAME}"
environment       = "${ENVIRONMENT}"
region            = "${AWS_REGION}"
availability_zone = "${SIM_DATA_VOLUME_AZ}"
size_gb           = ${SIM_DATA_VOLUME_GB}
iops              = ${SIM_DATA_VOLUME_IOPS}
throughput        = ${SIM_DATA_VOLUME_THROUGHPUT}
snapshot_id       = "${SIM_DATA_VOLUME_SNAPSHOT}"
EOF
}

# Creează volumul de date dacă lipsește. Dacă există, nu îl atinge: datele de pe el sunt
# prețioase, iar o dimensiune schimbată ar aplica o extindere, nu o recrare.
ensure_data_volume() {
  if [[ "${SIM_DATA_VOLUME_ENABLED}" != "true" ]]; then
    plain "  ${C_DIM}volumul de date este dezactivat (SIM_DATA_VOLUME_ENABLED=false)${C_RESET}"
    return 0
  fi

  # Volumul se plătește lunar cât timp există, deci comanda care îl poate crea cere comutatorul.
  # Refuzul e deliberat fail-closed, inclusiv când volumul există deja: citirea stării lui este
  # `data`, care rămâne permisă fără comutator.
  require_launch_enabled "crearea volumului de date (EBS)" "make sim-data-up   (sau ./tools/twinctl/twinctl data-up)"

  ensure_data_ready

  local existing
  existing="$(data_volume_id)"
  if [[ -n "${existing}" ]]; then
    ok "volum de date existent: ${existing} în $(data_volume_az) ($(data_tf_out size_gb) GB)"
    return 0
  fi

  local az="${SIM_DATA_VOLUME_AZ}"
  if [[ -z "${az}" ]]; then
    info "aleg zona volumului de date (cea mai ieftină capacitate spot acum)"
    az="$(cheapest_spot_az)"
    [[ -n "${az}" ]] || die "nu am putut citi prețurile spot; setați SIM_DATA_VOLUME_AZ în .env"
    ok "zonă aleasă: ${az} (rămâne fixă cât trăiește volumul)"
    if [[ -f "${ROOT}/.env" ]]; then
      set_env_var SIM_DATA_VOLUME_AZ "${az}"
    else
      warn "nu există .env: scrieți SIM_DATA_VOLUME_AZ=${az} ca să păstrați zona"
    fi
    SIM_DATA_VOLUME_AZ="${az}"
  fi

  # Volumul lipsește. Ordinea: `data-up --fresh` cere un volum gol, o valoare explicită în
  # SIM_DATA_VOLUME_SNAPSHOT (ori `data-up --snapshot`) impune un snapshot anume, iar altfel
  # reluăm automat ultimul snapshot, ca `make sim-up` să readucă singură starea de dinaintea
  # ștergerii.
  local from_env="${SIM_DATA_VOLUME_SNAPSHOT}"
  local snapshot="${from_env}"

  if [[ "${SIM_DATA_VOLUME_FRESH:-}" == "true" ]]; then
    snapshot=""
    if [[ -n "${from_env}" ]]; then
      [[ -f "${ROOT}/.env" ]] && set_env_var SIM_DATA_VOLUME_SNAPSHOT ""
      plain "      SIM_DATA_VOLUME_SNAPSHOT golit în .env (--fresh ignoră snapshot-urile)"
      from_env=""
    fi
  elif [[ -z "${snapshot}" ]]; then
    local latest=""
    latest="$(data_snapshot_ids)"
    if [[ -n "${latest}" ]]; then
      snapshot="${latest%%$'\n'*}"
      ok "reiau ultimul snapshot al volumului: ${snapshot}"
    else
      plain "  ${C_DIM}nu există snapshot al volumului; creez un volum gol${C_RESET}"
    fi
  fi
  SIM_DATA_VOLUME_SNAPSHOT="${snapshot}"

  # Un volum nou nu poate fi mai mic decât snapshot-ul din care pornește. Cel mai des se
  # întâmplă când cineva indică snapshot-ul discului rădăcină (200 GB) în loc de unul al
  # volumului de date (100 GB); AWS ar refuza cu un mesaj neclar.
  if [[ -n "${snapshot}" ]]; then
    local snap_size snap_name
    snap_size="$(aws_cli ec2 describe-snapshots --snapshot-ids "${snapshot}" \
      --query 'Snapshots[0].VolumeSize' --output text 2>/dev/null || true)"
    if [[ "${snap_size}" =~ ^[0-9]+$ ]] && (( snap_size > SIM_DATA_VOLUME_GB )); then
      die "snapshot-ul ${snapshot} are ${snap_size} GB, iar volumul de date este configurat la ${SIM_DATA_VOLUME_GB} GB; măriți SIM_DATA_VOLUME_GB peste ${snap_size}"
    fi
    # Un snapshot al discului rădăcină ține un sistem de operare întreg, nu conținutul lui
    # /opt/cncdt. Bootstrap-ul recunoaște structura și expune /opt/cncdt de pe volum prin bind
    # mount; merită spus, ca să nu pară că montarea a eșuat.
    snap_name="$(aws_cli ec2 describe-snapshots --snapshot-ids "${snapshot}" \
      --query 'Snapshots[0].Tags[?Key==`Name`]|[0].Value' --output text 2>/dev/null || true)"
    [[ "${snap_name}" == "None" ]] && snap_name=""
    if [[ -n "${snap_name}" && "${snap_name}" != "${PROJECT_NAME}-${ENVIRONMENT}-sim-data-"* ]]; then
      plain "  ${C_DIM}snapshot de disc rădăcină (${snap_name}): bootstrap-ul expune /opt/cncdt de pe volum prin bind mount${C_RESET}"
    fi
  fi

  generate_data_tfvars
  info "creez volumul de date (${SIM_DATA_VOLUME_GB} GB gp3 în ${az})"
  if ! data_tf apply -input=false -auto-approve -var launch_confirmed=true 2>&1 | tee "${STATE_DIR}/last-data-apply.log"; then
    die "crearea volumului de date a eșuat; jurnalul: ${STATE_DIR}/last-data-apply.log"
  fi
  ok "volum de date creat: $(data_volume_id)"

  # Un snapshot cerut explicit se folosește o singură dată: la următoarea recreare se ia iar
  # cel mai nou, nu aceeași stare veche.
  if [[ -n "${from_env}" ]]; then
    [[ -f "${ROOT}/.env" ]] && set_env_var SIM_DATA_VOLUME_SNAPSHOT ""
    plain "      SIM_DATA_VOLUME_SNAPSHOT golit în .env (se folosește la o singură creare)"
  fi
  SIM_DATA_VOLUME_SNAPSHOT=""
}

state_exists() {
  tf_ready && tf state list >/dev/null 2>&1 && [[ -n "$(tf state list 2>/dev/null | head -1)" ]]
}

current_instance_id() {
  tf_out instance_id
}

instance_field() {
  local id="$1" field="$2"
  aws_cli ec2 describe-instances --instance-ids "${id}" \
    --query "Reservations[].Instances[].${field}" --output text 2>/dev/null || true
}

instance_state() { instance_field "${1}" "State.Name"; }
instance_ip() { instance_field "${1}" "PublicIpAddress"; }
instance_launch_time() { instance_field "${1}" "LaunchTime"; }

wait_for_state() {
  local id="$1" want="$2" tries="${3:-60}"
  local i state
  for ((i = 0; i < tries; i++)); do
    state="$(instance_state "${id}")"
    [[ "${state}" == "${want}" ]] && return 0
    sleep 5
  done
  return 1
}

# Convertesc un timestamp ISO-8601 UTC (formatul AWS) în epoch, pe macOS și pe Linux.
iso_utc_to_epoch() {
  local clean
  # Elimin fracțiunile de secundă și sufixul de fus orar: AWS întoarce mereu UTC.
  clean="$(printf '%s' "$1" | sed -E 's/\..*//; s/([+-][0-9]{2}:[0-9]{2}|Z)$//')"
  if date -j -u -f "%Y-%m-%dT%H:%M:%S" "${clean}" "+%s" 2>/dev/null; then
    return 0
  fi
  date -u -d "${clean}" "+%s" 2>/dev/null || echo 0
}

instance_minutes_running() {
  local id="$1" launch launch_epoch now_epoch
  launch="$(instance_launch_time "${id}")"
  [[ -z "${launch}" ]] && { echo 0; return; }
  launch_epoch="$(iso_utc_to_epoch "${launch}")"
  now_epoch="$(date "+%s")"
  if [[ -z "${launch_epoch}" || "${launch_epoch}" -eq 0 ]]; then
    echo 0
    return
  fi
  echo $(( (now_epoch - launch_epoch) / 60 ))
}

# ---------------------------------------------------------------- init
cmd_init() {
  info "verific uneltele necesare"
  require_cmd terraform "Instalați: brew install terraform"
  require_cmd aws "Instalați AWS CLI v2: https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html"
  require_cmd jq "Instalați: brew install jq"
  ok "terraform, aws, jq"

  if has_ssm_plugin; then
    ok "session-manager-plugin prezent (acces fără port SSH deschis)"
  else
    warn "session-manager-plugin lipsește; modul implicit de acces va fi SSH prin portul 22"
    plain "      instalare: brew install --cask session-manager-plugin"
  fi

  info "verific credențialele AWS (profil ${AWS_PROFILE}, regiune ${AWS_REGION})"
  local ident
  ident="$(aws_cli sts get-caller-identity --output json 2>/dev/null)" \
    || die "credențialele AWS nu funcționează. Rulați \`aws configure\` sau setați AWS_PROFILE."
  ok "cont $(jq -r .Account <<<"${ident}") ca $(jq -r .Arn <<<"${ident}")"

  generate_tfvars
  ensure_tf_ready

  if [[ -n "${SIM_SSH_KEY_NAME}" ]]; then
    ok "folosesc cheia SSH existentă în AWS: ${SIM_SSH_KEY_NAME}"
  elif [[ -f "${SIM_SSH_PUBLIC_KEY}" ]]; then
    ok "cheie publică găsită: ${SIM_SSH_PUBLIC_KEY}"
  else
    info "generez o cheie SSH dedicată proiectului"
    mkdir -p "$(dirname "${SIM_SSH_PUBLIC_KEY}")"
    ssh-keygen -t ed25519 -C "${PROJECT_NAME}-sim" -f "${SIM_SSH_PRIVATE_KEY}" -N "" >/dev/null
    ok "cheie creată: ${SIM_SSH_PRIVATE_KEY} (și .pub)"
    generate_tfvars
  fi

  if [[ -z "${SIM_ASSETS_BUCKET}" ]]; then
    local bucket
    bucket="$(aws_cli s3api list-buckets \
      --query "Buckets[?starts_with(Name, '${PROJECT_NAME}-${ENVIRONMENT}-assets-')].Name | [0]" \
      --output text 2>/dev/null || true)"
    if [[ -n "${bucket}" && "${bucket}" != "None" ]]; then
      ok "bucket de asset-uri detectat: ${bucket}"
      plain "      adăugați în .env: SIM_ASSETS_BUCKET=${bucket}"
    else
      warn "nu am găsit un bucket de asset-uri. Rulați \`make platform-up\` pentru stack-ul de platformă."
    fi
  else
    ok "bucket de asset-uri: ${SIM_ASSETS_BUCKET}"
  fi

  info "verific dacă tipul de instanță este disponibil în ${AWS_REGION}"
  local azs
  azs="$(aws_cli ec2 describe-instance-type-offerings \
    --location-type availability-zone \
    --filters "Name=instance-type,Values=${SIM_INSTANCE_TYPE}" \
    --query 'InstanceTypeOfferings[].Location' --output text 2>/dev/null || true)"
  if [[ -n "${azs}" && "${azs}" != "None" ]]; then
    ok "${SIM_INSTANCE_TYPE} disponibil în: ${azs}"
  else
    warn "${SIM_INSTANCE_TYPE} nu apare ca disponibil în ${AWS_REGION}; alegeți altă regiune sau alt tip"
  fi

  plain ""
  ok "gata. Următorul pas: make sim-up"
}

# ---------------------------------------------------------------- conectare
print_connection_info() {
  # Rezumatul necesar pentru a vă conecta: IP, porturi, URL, SSH/SSM, stare TURN.
  local id="$1"
  local state ip private_ip az turn signaling stream url ssh_cmd ssm_cmd vpn vpn_dns vpn_url

  state="$(instance_state "${id}")"
  ip="$(tf_out public_ip)"
  private_ip="$(tf_out private_ip)"
  az="$(tf_out availability_zone)"
  turn="$(tf_out turn_enabled)"
  signaling="$(tf_out signaling_port)"
  stream="$(tf_out stream_port)"
  url="$(tf_out webrtc_url)"
  ssh_cmd="$(tf_out ssh_command)"
  ssm_cmd="$(tf_out ssm_shell_command)"

  # Cu tunelul pornit, porturile de streaming nu mai sunt publice: clientul se conectează la
  # adresa privată a instanței, prin VPN, deci adresa de dat clientului este cea din tunel.
  vpn="$(tf_out vpn_enabled)"
  vpn_dns="$(tf_out vpn_endpoint_dns_name)"
  vpn_url="$(tf_out internal_url)"
  if [[ "${vpn}" == "true" && -n "${vpn_url}" ]]; then
    url="${vpn_url}"
  fi

  plain ""
  printf '%s\n' "${C_BOLD}Date de conectare — Isaac Sim${C_RESET}"
  row "instanță" "${id}"
  row "stare" "${state:-<necunoscută>}"
  row "IP public" "${ip:-<alocat la pornire>}  (Elastic IP)"
  row "IP privat" "${private_ip:-<necunoscut>}"
  row "zonă" "${az:-<necunoscută>}"
  row "port semnalizare" "${signaling:-49100}/TCP"
  row "media (UDP)" "$(tf_out media_port_range)"
  if [[ "${turn}" == "true" ]]; then
    row "TURN/STUN" "pornit (3478/TCP+UDP, releu 49160-49200/UDP)"
  else
    row "TURN/STUN" "oprit (SIM_ENABLE_TURN=true pentru acces fără tunel)"
  fi
  if [[ "${vpn}" == "true" ]]; then
    row "tunel VPN" "${vpn_dns:-<se creează>} (${SIM_VPN_PORT}/${SIM_VPN_TRANSPORT})"
    row "adrese tunel" "${SIM_VPN_CLIENT_CIDR}"
  fi
  plain ""
  row "server client" "${url}"
  [[ -n "${ssh_cmd}" ]] && row "SSH" "${ssh_cmd}"
  [[ -n "${ssm_cmd}" ]] && row "shell SSM" "${ssm_cmd}"
  if [[ "${vpn}" == "true" ]]; then
    plain "  ${C_DIM}1. Importați profilul:  ./tools/twinctl/twinctl vpn-config${C_RESET}"
    plain "  ${C_DIM}2. Conectați profilul în AWS VPN Client, apoi folosiți „${url}\".${C_RESET}"
  else
    plain "  ${C_DIM}Introduceți „${url}\" în Isaac Sim WebRTC Streaming Client (aplicația nativă).${C_RESET}"
  fi
  plain "  ${C_DIM}Isaac Sim 5.0 nu mai servește pagina /streaming/webrtc-client în browser.${C_RESET}"
}

# ---------------------------------------------------------------- up
cmd_up() {
  local wait_bootstrap="false" auto_approve="true" plan_only="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait_bootstrap="true" ;;
      --plan) plan_only="true" ;;
      --no-auto-approve) auto_approve="false" ;;
      *) die "opțiune necunoscută pentru up: $1" ;;
    esac
    shift
  done

  require_cmd terraform
  load_env
  # Orice cale de lansare cere comutatorul din .env: refuzul vine înainte de AWS și înainte de
  # orice creare, inclusiv înainte de crearea volumului de date din pasul următor.
  require_launch_enabled "crearea instanței GPU" "make sim-up   (sau ./tools/twinctl/twinctl up)"
  # Volumul se creează înaintea instanței: de ID-ul și de zona lui depinde tfvars-ul stack-ului
  # `sim`, iar zona devine obligatorie pentru instanță.
  ensure_data_volume
  if [[ "${SIM_DATA_VOLUME_ENABLED}" == "true" ]]; then
    local existing_volume
    existing_volume="$(data_volume_id)"
    if [[ -n "${existing_volume}" ]]; then
      wait_for_data_volume_free "${existing_volume}"
    fi
  fi
  generate_tfvars
  ensure_tf_ready

  if [[ "${plan_only}" == "true" ]]; then
    tf plan -input=false -var launch_confirmed=true -out=plan.out
    return 0
  fi

  require_cmd aws

  if state_exists; then
    local existing_id existing_state
    existing_id="$(current_instance_id)"
    existing_state="$(instance_state "${existing_id}")"
    if [[ "${existing_state}" == "terminated" || "${existing_state}" == "shutting-down" ]]; then
      # Cererea spot `one-time` se închide când AWS retrage capacitatea, iar instanța se
      # termină singură. Volumul de date se detașează și rămâne în stack-ul lui, deci apply-ul
      # care urmează creează o instanță nouă și reatașează același volum.
      warn "instanța ${existing_id} a fost terminată (AWS a retras capacitatea spot)"
      plain "      apply-ul creează o instanță nouă și reatașează volumul de date existent."
    else
      warn "există deja o instanță în state: ${existing_id} (stare: ${existing_state})"
      plain "      folosiți \`start\` pentru a o reporni sau \`down\` pentru a o șterge."
    fi
  fi

  local -a apply_args=(-input=false)
  # Comutatorul a fost verificat mai sus, deci confirmarea explicită deblochează gardul din
  # `stacks/sim` (precondiția refuză orice plan ori apply fără ea).
  apply_args+=(-var launch_confirmed=true)
  if [[ "${auto_approve}" == "true" ]]; then
    apply_args+=(-auto-approve)
  fi

  info "aplic Terraform (poate dura 2-4 minute până pornește instanța)"
  # Jurnalul aplicării rămâne în .twinctl ca să putem recunoaște eșecurile de capacitate spot,
  # care nu se văd în mesajul scurt de eroare al Terraform.
  local apply_log="${STATE_DIR}/last-apply.log"
  if ! tf apply "${apply_args[@]}" 2>&1 | tee "${apply_log}"; then
    if grep -Eqi "insufficientinstancecapacity|unfulfillablecapacity|no spot capacity|spotmaxpricetoolow" "${apply_log}"; then
      warn "AWS nu are capacitate spot disponibilă acum pentru ${SIM_INSTANCE_TYPE}"
      plain "      capacitatea spot se schimbă des: reîncercați în câteva minute."
      plain "      alternativ, alt tip de instanță: SIM_INSTANCE_TYPE în .env."
    fi
    die "terraform apply a eșuat; jurnalul: ${apply_log#"${ROOT}/"}"
  fi

  local id
  id="$(current_instance_id)"
  ok "instanță creată: ${id}"
  printf '  %-14s %s\n' "tip" "$(tf_out instance_type)"
  printf '  %-14s %s\n' "piață" "$(instance_market "${id}")"
  printf '  %-14s %s\n' "AMI" "$(tf_out ami_id)"
  printf '  %-14s %s\n' "regiune" "${AWS_REGION}"
  printf '  %-14s %s\n' "zonă" "$(tf_out availability_zone)"
  local volume_id
  volume_id="$(tf_out data_volume_id)"
  if [[ -n "${volume_id}" ]]; then
    printf '  %-14s %s\n' "volum de date" "${volume_id} (persistent, montat la /opt/cncdt)"
  fi

  if [[ "${wait_bootstrap}" == "true" ]]; then
    wait_for_bootstrap "${id}"
  else
    plain ""
    plain "  Bootstrap-ul instalează driverele și scripturile de streaming (3-6 minute)."
    plain "  Urmăriți-l cu:  ./tools/twinctl/twinctl logs --bootstrap --follow"
  fi

  print_connection_info "${id}"

  plain ""
  plain "${C_BOLD}Următorii pași${C_RESET}"
  plain "  1. ./tools/twinctl/twinctl connect   # tunel pentru semnalizare + datele de conectare"
  plain "  2. introduceți serverul în Isaac Sim WebRTC Streaming Client (aplicația nativă)"
  plain "  3. dacă aplicația nu a pornit automat:"
  plain "     ./tools/twinctl/twinctl ssh /opt/cncdt/scripts/start-isaac.sh"
  plain "  4. codul extensiei nu vine din AMI:  ./tools/twinctl/twinctl push-sim"
}

wait_for_bootstrap() {
  local id="$1"
  info "aștept finalizarea bootstrap-ului (maximum $((BOOTSTRAP_TIMEOUT_SECONDS / 60)) minute)"

  if ! has_ssm_plugin && [[ "${SIM_SSH_ALLOWED_CIDRS}" == "" ]]; then
    warn "nu pot verifica bootstrap-ul: fără SSM și fără port SSH deschis"
    return 1
  fi

  local waited=0 interval=15
  while (( waited < BOOTSTRAP_TIMEOUT_SECONDS )); do
    if ssm_command "${id}" 'test -f /opt/cncdt/.bootstrapped && echo READY || echo PENDING' 2>/dev/null \
      | grep -q READY; then
      ok "bootstrap finalizat"
      return 0
    fi
    sleep "${interval}"
    waited=$(( waited + interval ))
    printf '\r  %s aștept... %ss' "${C_DIM}" "${waited}"
  done

  printf '\r'
  warn "bootstrap-ul nu a confirmat în $((BOOTSTRAP_TIMEOUT_SECONDS / 60)) de minute"
  plain "      verificați: ./tools/twinctl/twinctl logs --bootstrap --tail 80"
  return 1
}

ssm_command() {
  # Rulează o comandă pe instanță prin SSM și întoarce stdout.
  local id="$1" command="$2" timeout="${3:-120}"
  local cmd_id out status
  cmd_id="$(aws_cli ssm send-command \
    --instance-ids "${id}" \
    --document-name "AWS-RunShellScript" \
    --timeout-seconds "${timeout}" \
    --parameters "commands=${command}" \
    --query 'Command.CommandId' --output text 2>/dev/null)" || return 1
  [[ -z "${cmd_id}" || "${cmd_id}" == "None" ]] && return 1

  local i
  for ((i = 0; i < timeout / 3 + 10; i++)); do
    status="$(aws_cli ssm get-command-invocation --command-id "${cmd_id}" --instance-id "${id}" \
      --query 'Status' --output text 2>/dev/null || echo Pending)"
    case "${status}" in
      Success|Failed|Cancelled|TimedOut) break ;;
    esac
    sleep 3
  done

  out="$(aws_cli ssm get-command-invocation --command-id "${cmd_id}" --instance-id "${id}" \
    --query 'StandardOutputContent' --output text 2>/dev/null || true)"
  local err
  err="$(aws_cli ssm get-command-invocation --command-id "${cmd_id}" --instance-id "${id}" \
    --query 'StandardErrorContent' --output text 2>/dev/null || true)"

  printf '%s\n%s\n' "${out}" "${err}"
  [[ "${status}" == "Success" ]]
}

# ---------------------------------------------------------------- status
cmd_status() {
  local deep="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --deep) deep="true" ;;
      *) die "opțiune necunoscută pentru status: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready

  if ! state_exists; then
    warn "nu există instanță de simulare în state (${TF_DIR#"${ROOT}/"})"
    plain "      creați una cu: make sim-up"
    return 0
  fi

  local id state ip itype launch
  id="$(current_instance_id)"
  state="$(instance_state "${id}")"
  ip="$(instance_ip "${id}")"
  itype="$(instance_field "${id}" "InstanceType")"
  launch="$(instance_launch_time "${id}")"

  printf '%s\n' "${C_BOLD}Instanță de simulare${C_RESET}"
  row "ID" "${id}" 16
  row "tip" "${itype}" 16
  local market
  market="$(instance_market "${id}")"
  if [[ "${market}" == "on-demand" && "${SIM_USE_SPOT}" == "true" ]]; then
    market="on-demand (instanță creată înainte de trecerea pe spot; \`down\` + \`up\` o mută)"
  fi
  row "piață" "${market}" 16
  row "stare" "${state}" 16
  row "IP public" "${ip:-<alocat la pornire>}" 16
  row "regiune" "${AWS_REGION}" 16
  row "AMI" "$(tf_out ami_id)" 16
  row "lansată" "${launch:--}" 16

  local volume_id volume_size
  volume_id="$(tf_out data_volume_id)"
  if [[ -n "${volume_id}" ]]; then
    volume_size="$(data_tf_out size_gb)"
    row "volum date" "${volume_id} (${volume_size:-${SIM_DATA_VOLUME_GB}} GB gp3, persistent)" 16
  else
    row "volum date" "niciunul; starea stă doar pe discul rădăcină" 16
  fi

  local minutes
  minutes="$(instance_minutes_running "${id}")"
  local hours
  hours="$(awk -v m="${minutes}" 'BEGIN { printf "%.2f", m / 60 }')"
  row "durată" "${hours} h" 16

  local rate
  rate="$(hourly_rate_for "${id}" "${itype}")"
  if [[ -n "${rate}" && "${state}" == "running" ]]; then
    row "cost curent" "$(awk -v h="${hours}" -v r="${rate}" 'BEGIN { printf "~%.2f", h * r }') USD (tarif ${rate} USD/h)" 16
  fi

  row "log bootstrap" "$(tf_out bootstrap_log_group)" 16

  # Tuneluri active
  local tunnel_pids
  tunnel_pids="$(active_tunnels)"
  if [[ -n "${tunnel_pids}" ]]; then
    row "tunel" "activ (PID: $(tr '\n' ' ' <<<"${tunnel_pids}"))" 16
  else
    row "tunel" "închis" 16
  fi

  if [[ "${state}" != "running" ]]; then
    print_connection_info "${id}"
    return 0
  fi

  if [[ "${deep}" == "true" ]]; then
    plain ""
    info "autotestare pe instanță"
    ssm_command "${id}" '/opt/cncdt/scripts/selftest.sh' 300 || warn "autotestarea a eșuat (SSM indisponibil?)"
  elif has_ssm_plugin; then
    plain ""
    local container
    container="$(ssm_command "${id}" 'docker ps --filter name=isaac-sim --format "{{.Status}}" 2>/dev/null | head -1' 60 || true)"
    if [[ -n "${container// /}" ]]; then
      row "container" "${container}" 16
    else
      row "container" "oprit" 16
    fi
  fi

  print_connection_info "${id}"
}

