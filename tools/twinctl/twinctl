#!/usr/bin/env bash
# twinctl — ciclul de viață al instanței NVIDIA Isaac Sim, dintr-o singură comandă.
#
#   ./tools/twinctl/twinctl init       verificări prealabile, cheie SSH, bucket de asset-uri
#   ./tools/twinctl/twinctl up         creează instanța GPU
#   ./tools/twinctl/twinctl status     starea instanței și a containerului
#   ./tools/twinctl/twinctl connect    deschide tunelul și afișează URL-ul clientului WebRTC
#   ./tools/twinctl/twinctl stop       oprește instanța on-demand (pe spot se termină, vezi down)
#   ./tools/twinctl/twinctl data       starea volumului EBS persistent de date
#   ./tools/twinctl/twinctl down       șterge resursele de simulare (volumul de date rămâne)
#
# Toate operațiunile trec prin Terraform (`infra/terraform/stacks/sim` și `stacks/sim-data`,
# state local) și prin AWS CLI pentru acțiuni de runtime. Nu se folosește consola AWS.
#
# Instanța rulează pe spot (`SIM_USE_SPOT=true`): dacă AWS nu are capacitate, `up` eșuează cu
# un indiciu clar. Nu există revenire automată pe on-demand.

set -Eeuo pipefail

# ---------------------------------------------------------------- constante
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_PATH}/../.." && pwd)"
TF_DIR="${ROOT}/infra/terraform/stacks/sim"
TFVARS="${TF_DIR}/sim.auto.tfvars"
# Volumul de date stă în alt stack, cu alt state: `sim-down` nu îl poate atinge.
DATA_DIR="${ROOT}/infra/terraform/stacks/sim-data"
DATA_TFVARS="${DATA_DIR}/sim-data.auto.tfvars"
STATE_DIR="${ROOT}/.twinctl"
TUNNEL_DIR="${STATE_DIR}/tunnels"
BOOTSTRAP_TIMEOUT_SECONDS="${BOOTSTRAP_TIMEOUT_SECONDS:-1500}"

# Tarife pentru estimări. gp3, IOPS-ul, debitul, IPv4-ul public și g5.2xlarge au fost verificate
# cu AWS Price List API pentru eu-central-1 (Frankfurt). Restul tipurilor de instanță sunt valori
# aproximative de listă și servesc doar la ordinul de mărime.
