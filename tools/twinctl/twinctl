# ---------------------------------------------------------------- cost
cmd_cost() {
  load_env
  ensure_tf_ready
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  local id itype state market minutes hours rate
  id="$(current_instance_id)"
  itype="$(instance_field "${id}" "InstanceType")"
  state="$(instance_state "${id}")"
  market="$(instance_market "${id}")"
  minutes="$(instance_minutes_running "${id}")"
  hours="$(awk -v m="${minutes}" 'BEGIN { printf "%.2f", m / 60 }')"
  rate="$(hourly_rate_for "${id}" "${itype}")"
  [[ -z "${rate}" ]] && rate="unknown"

  printf '%s\n' "${C_BOLD}Estimare de cost${C_RESET}"
  row "tip instanță" "${itype}" 24
  row "piață" "${market}" 24
  row "tarif orar (approx.)" "${rate} USD" 24
  row "durată de la lansare" "${hours} h" 24

  if [[ "${rate}" != "unknown" && "${state}" == "running" ]]; then
    row "cost compute acumulat" "$(awk -v h="${hours}" -v r="${rate}" 'BEGIN { printf "%.2f", h * r }') USD" 24
  fi

  row "volum EBS (storage)" "$(awk -v gb="${SIM_ROOT_VOLUME_GB}" -v p="${EBS_GP3_GB_MONTH}" 'BEGIN { printf "%.2f", gb * p }') USD/lună (${SIM_ROOT_VOLUME_GB} GB gp3)" 24
  local extra_iops extra_mibps
  extra_iops="$(awk -v i="${SIM_ROOT_VOLUME_IOPS}" -v f="${GP3_FREE_IOPS}" 'BEGIN { v = i - f; if (v < 0) v = 0; printf "%d", v }')"
  extra_mibps="$(awk -v t="${SIM_ROOT_VOLUME_THROUGHPUT}" -v f="${GP3_FREE_MIBPS}" 'BEGIN { v = t - f; if (v < 0) v = 0; printf "%d", v }')"
  row "volum EBS (IOPS+debit)" \
    "$(awk -v i="${extra_iops}" -v pi="${EBS_GP3_IOPS_MONTH}" -v t="${extra_mibps}" -v pt="${EBS_GP3_MIBPS_MONTH}" \
      'BEGIN { printf "%.2f", i * pi + t * pt }') USD/lună (peste baseline)" 24
  # Volumul de date trăiește independent de instanță, deci se plătește și când nu rulează nimic.
  local volume_id
  volume_id="$(tf_out data_volume_id)"
  if [[ -n "${volume_id}" ]]; then
    row "volum de date (persistent)" \
      "$(awk -v gb="${SIM_DATA_VOLUME_GB}" -v p="${EBS_GP3_GB_MONTH}" \
        'BEGIN { printf "%.2f", gb * p }') USD/lună (${SIM_DATA_VOLUME_GB} GB gp3, se plătește și în repaus)" 24
  fi
  if [[ "${SIM_ALLOCATE_EIP}" == "true" ]]; then
    row "Elastic IP" "$(awk -v p="${PUBLIC_IPV4_HOUR}" 'BEGIN { printf "%.2f", p * 730 }') USD/lună" 24
  else
    row "Elastic IP" "0 (IP auto-atribuit, eliberat la oprire)" 24
  fi
  if [[ -n "${SIM_AMI_ID}" ]]; then
    row "snapshot AMI golden" "~2.70 USD/lună (billed pe blocurile folosite)" 24
  fi

  plain ""
  plain "  Tarifele gp3, IPv4 și on-demand sunt verificate în ${AWS_REGION}; prețul spot se"
  plain "  citește la fiecare rulare din istoricul de prețuri AWS, iar restul sunt aproximative."
  plain "  Costul real: AWS Cost Explorer, filtrat pe eticheta Project=${PROJECT_NAME}."
  plain "  Cel mai eficient control de cost: \`make sim-freeze\` urmat de \`make sim-down\`."
  plain "  Volumul de date se plătește și când nu rulează nimic: \`make sim-data\` arată starea lui."
}

# ---------------------------------------------------------------- piața spot
# Ce merită văzut înainte de o lansare: prețul spot pe fiecare zonă, tariful on-demand pentru
# comparație și scorul de capacitate. Scorul este o recomandare pe termen scurt: AWS îl
# calculează pentru o cerere de flotă și avertizează că pentru unul-două tipuri de instanță
# iese sistematic mic, deci îl cerem pe familia g5. Verificarea decisivă rămâne `make sim-up`.
cmd_spot() {
  load_env
  require_cmd aws

  printf '%s\n' "${C_BOLD}Piața spot: ${SIM_INSTANCE_TYPE} în ${AWS_REGION}${C_RESET}"

  local start
  start="$(date -u -v-6H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -d '6 hours ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"

  local -a price_args=(
    ec2 describe-spot-price-history
    --instance-types "${SIM_INSTANCE_TYPE}"
    --product-descriptions "Linux/UNIX"
  )
  [[ -n "${start}" ]] && price_args+=(--start-time "${start}")

  local prices
  prices="$(aws_cli "${price_args[@]}" \
    --query 'reverse(sort_by(SpotPriceHistory,&Timestamp))[].[AvailabilityZone,SpotPrice]' \
    --output text 2>/dev/null | awk '!vazut[$1]++ { print $1, $2 }')"

  if [[ -z "${prices}" ]]; then
    warn "nu am putut citi prețurile spot; verificați credențialele și regiunea"
  else
    local az price
    while read -r az price; do
      [[ -z "${az}" ]] && continue
      row "${az}" "$(awk -v p="${price}" 'BEGIN { printf "%.4f", p }') USD/h" 26
    done <<<"${prices}"
  fi

  local ondemand
  ondemand="$(instance_hourly_rate "${SIM_INSTANCE_TYPE}")"
  if [[ -n "${ondemand}" ]]; then
    row "on-demand (comparație)" "${ondemand} USD/h" 26
  fi

  local -a score_args=(
    ec2 get-spot-placement-scores
    --instance-types g5.xlarge g5.2xlarge g5.4xlarge
    --target-capacity 1
    --single-availability-zone
    --region-names "${AWS_REGION}"
  )
  local scores azmap
  scores="$(aws_cli "${score_args[@]}" \
    --query 'SpotPlacementScores[].[AvailabilityZoneId,Score]' --output text 2>/dev/null || true)"
  azmap="$(aws_cli ec2 describe-availability-zones \
    --query 'AvailabilityZones[].[ZoneName,ZoneId]' --output text 2>/dev/null || true)"

  if [[ -z "${scores}" ]]; then
    plain "  ${C_DIM}scorul de capacitate nu a putut fi citit${C_RESET}"
  else
    local azid score azname
    while read -r azid score; do
      [[ -z "${azid}" ]] && continue
      azname="$(awk -v id="${azid}" '$2 == id { print $1 }' <<<"${azmap}")"
      row "capacitate ${azname:-${azid}}" "${score}/10" 26
    done <<<"${scores}"
    plain "  ${C_DIM}1 = puțin probabil, 10 = foarte probabil, la cererea de acum${C_RESET}"
  fi

  if [[ "${SIM_USE_SPOT}" != "true" ]]; then
    plain ""
    warn "SIM_USE_SPOT nu este true: următoarea \`up\` cumpără instanța on-demand"
  fi
}

# ---------------------------------------------------------------- volumul de date
# Volumul EBS care ține starea Isaac Sim dincolo de viața instanței spot. Se creează o singură
# dată (`data-up`, ori automat la primul `up`), se atașează fiecărei instanțe și se șterge
# exclusiv cu `data-down`. Snapshot-urile se fac doar cu `data-snapshot`.
data_snapshot_ids() {
  # Snapshot-urile create de twinctl, cele mai noi primele. Se recunosc după eticheta Name;
  # doar cele `completed` se pot folosi la recrearea volumului.
  aws_cli ec2 describe-snapshots --owner-ids self \
    --filters "Name=tag:Name,Values=${PROJECT_NAME}-${ENVIRONMENT}-sim-data-*" \
    "Name=status,Values=completed" \
    --query 'reverse(sort_by(Snapshots,&StartTime))[].SnapshotId' --output text 2>/dev/null \
    | tr '\t' '\n' | sed -e '/^None$/d' -e '/^$/d'
}

data_volume_state() {
  aws_cli ec2 describe-volumes --volume-ids "$1" \
    --query 'Volumes[0].State' --output text 2>/dev/null || true
}

data_volume_attachment() {
  aws_cli ec2 describe-volumes --volume-ids "$1" \
    --query 'Volumes[0].Attachments[0].InstanceId' --output text 2>/dev/null || true
}

# AWS detașează volumul când instanța spot se termină, dar nu instantaneu. Dacă AWS tocmai a
# retras capacitatea și relansăm imediat, atașarea ar eșua cu `VolumeInUse`. Așteptăm scurt.
wait_for_data_volume_free() {
  local volume_id="$1" tries="${2:-24}" attempt=0 state attached
  while (( attempt < tries )); do
    state="$(data_volume_state "${volume_id}")"
    [[ "${state}" == "in-use" ]] || return 0
    attached="$(data_volume_attachment "${volume_id}")"
    [[ -z "${attached}" || "${attached}" == "None" ]] && return 0
    if (( attempt == 0 )); then
      info "volumul ${volume_id} e încă atașat instanței ${attached}; aștept detașarea"
    fi
    sleep 5
    attempt=$((attempt + 1))
  done
  warn "volumul ${volume_id} este încă atașat după 2 minute; apply-ul poate eșua cu VolumeInUse"
}

cmd_data() {
  load_env

  printf '%s\n' "${C_BOLD}Volum de date (persistent)${C_RESET}"
  if [[ "${SIM_DATA_VOLUME_ENABLED}" != "true" ]]; then
    warn "SIM_DATA_VOLUME_ENABLED=false: instanțele noi nu primesc volum de date"
  fi

  local id
  id="$(data_volume_id)"
  if [[ -z "${id}" ]]; then
    row "stare" "nu există; se creează automat la \`make sim-up\` sau explicit cu \`make sim-data-up\`" 14
    return 0
  fi

  local az state attached size
  az="$(data_volume_az)"
  state="$(data_volume_state "${id}")"
  attached="$(data_volume_attachment "${id}")"
  [[ "${attached}" == "None" ]] && attached=""
  size="$(data_tf_out size_gb)"

  row "ID" "${id}" 14
  row "zonă" "${az}" 14
  row "stare" "${state}" 14
  row "dimensiune" "${size} GB gp3 ($(data_tf_out iops) IOPS, $(data_tf_out throughput) MiB/s)" 14
  row "atașat la" "${attached:-<detașat>}" 14
  row "cost lunar" \
    "$(awk -v gb="${size}" -v p="${EBS_GP3_GB_MONTH}" 'BEGIN { printf "%.2f", gb * p }') USD (se plătește mereu)" 14

  local snaps
  snaps="$(data_snapshot_ids)"
  if [[ -n "${snaps}" ]]; then
    plain ""
    plain "  ${C_BOLD}Snapshot-uri${C_RESET}"
    local snap line
    while read -r snap; do
      [[ -n "${snap}" ]] || continue
      line="$(aws_cli ec2 describe-snapshots --snapshot-ids "${snap}" \
        --query 'Snapshots[0].[StartTime,VolumeSize,State]' --output text 2>/dev/null || true)"
      row "${snap}" "${line}" 26
    done <<<"${snaps}"
  fi

  plain ""
  plain "  Dacă volumul lipsește, \`make sim-up\` îl recreează și reia automat ultimul snapshot."
  plain "  Se șterge doar cu:  make sim-data-down"
  plain "  Snapshot manual:    make sim-data-snapshot"
}

cmd_data_up() {
  local snapshot="" fresh="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --snapshot) snapshot="${2:-}"; shift ;;
      --fresh) fresh="true" ;;
      *) die "opțiune necunoscută pentru data-up: $1" ;;
    esac
    shift
  done

  load_env
  require_cmd terraform
  # Refuzul vine înainte de orice efect local (scrierea zonei ori a snapshot-ului în .env) și
  # înainte de `terraform init`; `ensure_data_volume` reia verificarea pentru calea din `up`.
  require_launch_enabled "crearea volumului de date (EBS)" "make sim-data-up   (sau ./tools/twinctl/twinctl data-up)"

  if [[ -n "${snapshot}" ]]; then
    set_env_var SIM_DATA_VOLUME_SNAPSHOT "${snapshot}"
    SIM_DATA_VOLUME_SNAPSHOT="${snapshot}"
    ok "volumul va porni din snapshot-ul ${snapshot}"
  fi
  if [[ "${fresh}" == "true" ]]; then
    SIM_DATA_VOLUME_FRESH="true"
    warn "volum gol cerut explicit: nu se reia niciun snapshot"
  fi

  local before
  before="$(data_volume_id)"
  ensure_data_volume

  if [[ -n "${before}" && "${before}" == "$(data_volume_id)" ]]; then
    plain "  volumul exista deja; nu am schimbat nimic"
  fi
  plain ""
  cmd_data
}

cmd_data_down() {
  local assume_yes="false" snapshot="true"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes="true" ;;
      --no-snapshot) snapshot="false" ;;
      *) die "opțiune necunoscută pentru data-down: $1" ;;
    esac
    shift
  done

  load_env

  local id
  id="$(data_volume_id)"
  if [[ -z "${id}" ]]; then
    ok "nu există volum de date; nimic de șters"
    return 0
  fi

  local attached
  attached="$(data_volume_attachment "${id}")"
  if [[ -n "${attached}" && "${attached}" != "None" ]]; then
    die "volumul ${id} este atașat instanței ${attached}; rulați întâi \`make sim-down\` (o detașează), apoi repetați"
  fi

  printf '%s\n' "${C_BOLD}Se va șterge volumul de date:${C_RESET}"
  row "volum" "${id} ($(data_tf_out size_gb) GB gp3 în $(data_volume_az))" 24
  row "conținut" "asset-uri Isaac Sim, cache, modele, simulation/ de pe instanță" 24
  if [[ "${snapshot}" == "true" ]]; then
    row "înainte de ștergere" "se creează un snapshot manual" 24
  else
    row "înainte de ștergere" "FĂRĂ snapshot: datele se pierd definitiv" 24
  fi
  plain ""

  if [[ "${assume_yes}" != "true" ]]; then
    read -r -p "Confirmați ștergerea volumului de date? scrieți 'da': " answer
    [[ "${answer}" == "da" ]] || { warn "anulat"; return 1; }
  fi

  if [[ "${snapshot}" == "true" ]]; then
    cmd_data_snapshot || die "snapshot-ul a eșuat; nu șterg volumul"
  fi

  ensure_data_ready
  # Ștergerea nu depinde de comutator: `launch_confirmed=true` e trimis explicit ca precondiția
  # din `stacks/sim-data` să nu poată bloca teardown-ul pe nicio versiune de Terraform.
  data_tf destroy -input=false -auto-approve -var launch_confirmed=true

  ok "volumul de date a fost șters"
  local remaining
  remaining="$(data_snapshot_ids)"
  if [[ -n "${remaining}" ]]; then
    plain "      snapshot-urile rămân, iar următorul \`make sim-up\` reia automat cel mai nou:"
    local snap
    while read -r snap; do
      [[ -n "${snap}" ]] || continue
      plain "        ${snap}"
    done <<<"${remaining}"
    plain "      pentru un volum gol: make sim-data-up FRESH=1"
  fi
  plain "      recreați cu: make sim-data-up (aceeași zonă: ${SIM_DATA_VOLUME_AZ:-<nesetat>})"
}

cmd_data_snapshot() {
  local list_only="false" keep="" assume_yes="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list_only="true" ;;
      --keep) keep="${2:-}"; shift ;;
      --yes|-y) assume_yes="true" ;;
      *) die "opțiune necunoscută pentru data-snapshot: $1" ;;
    esac
    shift
  done

  load_env

  local snaps snap
  if [[ "${list_only}" == "true" ]]; then
    snaps="$(data_snapshot_ids)"
    if [[ -z "${snaps}" ]]; then
      plain "  niciun snapshot al volumului de date"
      return 0
    fi
    plain "${C_BOLD}Snapshot-uri ale volumului de date${C_RESET}"
    while read -r snap; do
      [[ -n "${snap}" ]] || continue
      row "${snap}" "$(aws_cli ec2 describe-snapshots --snapshot-ids "${snap}" \
        --query 'Snapshots[0].[StartTime,VolumeSize,State]' --output text 2>/dev/null || true)" 26
    done <<<"${snaps}"
    return 0
  fi

  local id
  id="$(data_volume_id)"
  if [[ -z "${id}" ]]; then
    # Fără volum: rămâne doar curățarea snapshot-urilor, ca ele să poată fi șterse și după
    # `make sim-data-down` (altfel `KEEP` ar cere un volum care nu mai există).
    [[ -n "${keep}" ]] || die "nu există volum de date; creați-l cu \`make sim-data-up\` (reia automat ultimul snapshot)"
    prune_data_snapshots "${keep}" "${assume_yes}"
    return 0
  fi

  local name
  name="${PROJECT_NAME}-${ENVIRONMENT}-sim-data-$(date -u +%Y%m%d-%H%M%S)"
  info "creez snapshot din ${id}"
  snap="$(aws_cli ec2 create-snapshot --volume-id "${id}" \
    --description "Volum de date ${id} (${name})" \
    --query 'SnapshotId' --output text)" || die "create-snapshot a eșuat"
  ok "snapshot pornit: ${snap}"

  aws_cli ec2 create-tags --resources "${snap}" \
    --tags "Key=Name,Value=${name}" "Key=Project,Value=${PROJECT_NAME}" \
    "Key=Environment,Value=${ENVIRONMENT}" "Key=ManagedBy,Value=twinctl" >/dev/null \
    || warn "etichetarea snapshot-ului a eșuat (snapshot-ul rămâne valid)"

  info "aștept starea completed (minute, în funcție de blocurile modificate)"
  local waited=0 state
  while :; do
    state="$(aws_cli ec2 describe-snapshots --snapshot-ids "${snap}" --query 'Snapshots[0].State' --output text)"
    [[ "${state}" == "completed" ]] && break
    [[ "${state}" == "error" ]] && die "snapshot-ul a eșuat"
    sleep 15
    waited=$((waited + 15))
    if (( waited % 60 == 0 )); then plain "   ${state}... ${waited}s"; fi
    if (( waited > 7200 )); then die "snapshot-ul nu s-a terminat în 2 ore"; fi
  done
  ok "snapshot disponibil: ${snap}"

  [[ -n "${keep}" ]] || return 0
  prune_data_snapshots "${keep}" "${assume_yes}"
}

# Păstrează cele mai noi `keep` snapshot-uri ale volumului de date și le șterge pe celelalte.
prune_data_snapshots() {
  local keep="$1" assume_yes="${2:-false}"
  [[ "${keep}" =~ ^[0-9]+$ ]] || die "--keep cere un număr întreg"

  local -a all=() old=()
  local snap
  while read -r snap; do [[ -n "${snap}" ]] && all+=("${snap}"); done < <(data_snapshot_ids)
  if (( ${#all[@]} <= keep )); then
    plain "  nimic de șters: ${#all[@]} snapshot-uri, --keep ${keep}"
    return 0
  fi

  old=("${all[@]:keep}")
  plain "  ${#old[@]} snapshot-uri mai vechi de șters: ${old[*]}"
  if [[ "${assume_yes}" != "true" ]]; then
    local answer
    read -r -p "Confirmați ștergerea acestor snapshot-uri? scrieți 'da': " answer
    [[ "${answer}" == "da" ]] || { warn "ștergerea snapshot-urilor a fost anulată"; return 0; }
  fi
  for snap in "${old[@]}"; do
    aws_cli ec2 delete-snapshot --snapshot-id "${snap}" >/dev/null && ok "șters: ${snap}"
  done
}

# ---------------------------------------------------------------- AMI golden
# Fluxul economic: în loc să ții un volum EBS de 200 GB pentru o instanță oprită, faci o
# imagine (AMI) din instanță și ștergi tot. Când reiei lucrul, `up` pornește din AMI, cu Isaac
# Sim deja instalat, iar în repaus plătești doar snapshot-ul (billed pe blocurile folosite).

set_env_var() {
  # Scrie NAME=value în .env păstrând restul fișierului.
  local name="$1" value="$2" file="${ROOT}/.env" tmp
  [[ -f "${file}" ]] || die "nu există ${file}"
  tmp="$(mktemp)"
  if grep -q "^${name}=" "${file}"; then
    awk -v n="${name}" -v v="${value}" \
      'BEGIN { FS = "=" } $1 == n { print n "=" v; next } { print }' "${file}" > "${tmp}"
  else
    cp "${file}" "${tmp}"
    printf '%s=%s\n' "${name}" "${value}" >> "${tmp}"
  fi
  mv "${tmp}" "${file}"
}

golden_ami_ids() {
  # ID-urile AMI-urilor golden, cele mai noi primele.
  aws_cli ec2 describe-images --owners self \
    --filters "Name=name,Values=${SIM_GOLDEN_AMI_PREFIX}-*" \
    --query 'reverse(sort_by(Images,&CreationDate))[].ImageId' --output text 2>/dev/null \
    | tr '\t' '\n' | sed -e '/^None$/d' -e '/^$/d'
}

ami_snapshot_ids() {
  aws_cli ec2 describe-images --image-ids "$1" \
    --query 'Images[].BlockDeviceMappings[].Ebs.SnapshotId' --output text 2>/dev/null \
    | tr '\t' '\n' | sed -e '/^None$/d' -e '/^$/d'
}

delete_ami() {
  # Întâi se deregistrează AMI-ul, apoi se șterg snapshot-urile: cât timp AMI-ul le referă,
  # `delete-snapshot` e refuzat de AWS.
  local ami="$1" snaps
  snaps="$(ami_snapshot_ids "${ami}")"
  aws_cli ec2 deregister-image --image-id "${ami}" >/dev/null
  local snap
  while read -r snap; do
    [[ -n "${snap}" ]] || continue
    aws_cli ec2 delete-snapshot --snapshot-id "${snap}" >/dev/null
  done <<<"${snaps}"
}

cmd_freeze() {
  local keep="" list_only="false" clear="false" assume_yes="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list_only="true" ;;
      --clear) clear="true" ;;
      --keep) keep="${2:-}"; shift ;;
      --yes|-y) assume_yes="true" ;;
      *) die "opțiune necunoscută pentru freeze: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready

  if [[ "${clear}" == "true" ]]; then
    set_env_var SIM_AMI_ID ""
    ok "SIM_AMI_ID golit: următoarea \`up\` pornește din AMI-ul de bază Amazon Deep Learning"
    return 0
  fi

  if [[ "${list_only}" == "true" ]]; then
    plain "${C_BOLD}AMI-uri golden${C_RESET}"
    aws_cli ec2 describe-images --owners self \
      --filters "Name=name,Values=${SIM_GOLDEN_AMI_PREFIX}-*" \
      --query 'reverse(sort_by(Images,&CreationDate))[].{Nume:Name,Id:ImageId,Stare:State,GB:BlockDeviceMappings[0].Ebs.VolumeSize}' \
      --output table
    row "SIM_AMI_ID" "${SIM_AMI_ID:-<gol>}" 14
    return 0
  fi

  state_exists || die "nu există instanță; rulați întâi \`up\`"
  local id state
  id="$(current_instance_id)"
  state="$(instance_state "${id}")"
  [[ "${state}" == "running" ]] \
    || die "instanța este ${state}; porniți-o cu \`start\` înainte de a o îngheța"

  local name="${SIM_GOLDEN_AMI_PREFIX}-$(date -u +%Y%m%d-%H%M%S)"
  info "creez AMI din ${id} (fără reboot)"
  local ami
  ami="$(aws_cli ec2 create-image --instance-id "${id}" --name "${name}" \
    --description "Isaac Sim ${SIM_ISAAC_SIM_IMAGE}, bootstrap finalizat" \
    --no-reboot --query 'ImageId' --output text)" || die "create-image a eșuat"
  ok "AMI pornit: ${ami}"

  # Sintaxa scurtă a CLI cere perechi Key=...,Value=...; „Project=cncdt" ar fi citit ca membru
  # de structură și refuzat. Etichetarea nu e critică: un eșec nu trebuie să anuleze AMI-ul.
  aws_cli ec2 create-tags --resources "${ami}" \
    --tags "Key=Project,Value=${PROJECT_NAME}" "Key=Environment,Value=${ENVIRONMENT}" \
    "Key=ManagedBy,Value=twinctl" >/dev/null \
    || warn "etichetarea AMI-ului a eșuat (AMI-ul rămâne valid)"

  info "aștept starea available (câteva minute, cât se scrie snapshot-ul)"
  local waited=0
  while :; do
    state="$(aws_cli ec2 describe-images --image-ids "${ami}" --query 'Images[0].State' --output text)"
    [[ "${state}" == "available" ]] && break
    [[ "${state}" == "failed" ]] && die "AMI-ul a eșuat"
    sleep 15
    waited=$((waited + 15))
    if (( waited % 60 == 0 )); then plain "   ${state}... ${waited}s"; fi
    if (( waited > 3600 )); then die "AMI-ul nu s-a terminat în 60 de minute"; fi
  done
  ok "AMI disponibil"

  set_env_var SIM_AMI_ID "${ami}"
  ok "SIM_AMI_ID actualizat în .env"

  if [[ -n "${keep}" ]]; then
    [[ "${keep}" =~ ^[0-9]+$ ]] || die "--keep cere un număr întreg"
    local -a all=() old=()
    while read -r line; do [[ -n "${line}" ]] && all+=("${line}"); done < <(golden_ami_ids)
    if (( ${#all[@]} <= keep )); then
      plain "  nimic de șters: ${#all[@]} AMI-uri golden, --keep ${keep}"
    else
      old=("${all[@]:keep}")
      printf '%s\n' "${C_BOLD}Se vor șterge ${#old[@]} AMI-uri golden mai vechi:${C_RESET}"
      local a
      for a in "${old[@]}"; do row "AMI" "${a}" 12; done
      if [[ "${assume_yes}" != "true" ]]; then
        local answer
        read -r -p "Confirmați ștergerea? scrieți 'da': " answer
        [[ "${answer}" == "da" ]] || { warn "nu am șters nimic"; return 0; }
      fi
      for a in "${old[@]}"; do
        delete_ami "${a}" && ok "șters ${a}"
      done
    fi
  fi

  plain ""
  plain "  Costul în repaus este doar snapshot-ul: la ~50 GB folosiți, ~2,70 USD/lună."
  plain "  Ștergeți instanța cu:  make sim-down    (sau \`twinctl down --freeze\` dintr-o dată)"
}

# ---------------------------------------------------------------- push direct
cmd_push_sim() {
  # `push` trece prin S3 și are nevoie de bucket. Acesta copiază direct prin SSH, ceea ce e
  # suficient pentru codul extensiei (câteva sute de KB) și merge și fără stack-ul `platform`.
  load_env
  state_exists || die "nu există instanță; rulați întâi \`up\`"
  require_cmd rsync

  local id ip
  id="$(current_instance_id)"
  ip="$(instance_ip "${id}")"
  [[ -n "${ip}" ]] || die "instanța nu are IP public; folosiți \`push\` prin S3"

  info "sincronizez simulation/ către ubuntu@${ip}:/opt/cncdt/simulation"
  rsync -az --delete \
    --exclude '__pycache__' --exclude 'logs' --exclude 'assets/*.usd*' \
    -e "ssh -i ${SIM_SSH_PRIVATE_KEY} -o StrictHostKeyChecking=accept-new -o BatchMode=yes" \
    "${ROOT}/simulation/" "ubuntu@${ip}:/opt/cncdt/simulation/"
  ok "codul extensiei este actualizat pe instanță"
  plain "      containerul citește codul la pornire; reporniți-l cu:"
  plain "      ./tools/twinctl/twinctl ssh 'docker restart isaac-sim'"
}

# ---------------------------------------------------------------- Client VPN
cmd_vpn_config() {
  # AWS nu livrează certificatul de client în fișierul exportat, deci îl adăugăm noi din
  # output-ul Terraform. Rezultatul se importă direct în AWS VPN Client.
  load_env
  ensure_tf_ready
  require_cmd aws

  [[ "${SIM_VPN_ENABLED}" == "true" ]] \
    || die "VPN-ul este oprit; puneți SIM_VPN_ENABLED=true în .env și rulați \`make sim-up\`"

  local endpoint
  endpoint="$(tf_out vpn_endpoint_id)"
  [[ -n "${endpoint}" ]] || die "nu există endpoint Client VPN; rulați \`make sim-up\` întâi"

  local out="${HOME}/.cncdt/${PROJECT_NAME}-${ENVIRONMENT}-sim.ovpn"
  local base
  base="$(mktemp)"
  mkdir -p "$(dirname "${out}")"

  info "export configurația endpoint-ului ${endpoint}"
  aws_cli ec2 export-client-vpn-client-configuration \
    --client-vpn-endpoint-id "${endpoint}" \
    --query 'ClientConfiguration' --output text > "${base}" \
    || die "export-client-vpn-client-configuration a eșuat"

  {
    cat "${base}"
    printf '\n<cert>\n%s\n</cert>\n' "$(tf_out vpn_client_certificate)"
    printf '<key>\n%s\n</key>\n' "$(tf_out vpn_client_private_key)"
  } > "${out}"
  chmod 600 "${out}"
  rm -f "${base}"

  ok "profil VPN scris: ${out}"
  row "endpoint" "${endpoint}" 16
  row "DNS tunel" "$(tf_out vpn_endpoint_dns_name)" 16
  row "adrese clienți" "${SIM_VPN_CLIENT_CIDR}" 16
  row "instanță (privat)" "$(tf_out private_ip)" 16
  row "server WebRTC" "$(tf_out internal_url)" 16
  plain ""
  plain "  ${C_BOLD}Import în AWS VPN Client${C_RESET}"
  plain "    File → Manage Profiles → Add Profile → alegeți ${out}"
  plain "    Conectați profilul, apoi introduceți „$(tf_out internal_url)\" în clientul Isaac Sim."
  plain "  ${C_DIM}Cheia privată a clientului rămâne în ${out} (mod 600); nu o comitați.${C_RESET}"
}

# ---------------------------------------------------------------- vpn on/off
# Endpoint-ul Client VPN se taxează orar pentru fiecare subrețea asociată, conectat sau nu
# (~$0.10/oră în eu-central-1, deci ~$2.40/zi). Când nu e folosit, se șterge.
#
# Operațiile sunt țintite pe modulul VPN și pe regulile de tunel din grupul de securitate al
# instanței. Instanța, discul și restul stack-ului rămân neatinse, deci nu se declanșează nici
# înlocuirea instanței aflată în așteptare (AMI golden nou). Regulile publice de WebRTC nu fac
# parte din ținte: rămân cum sunt, ca accesul direct să nu depindă de tunel.
VPN_TARGETS=(
  -target=module.vpn
  -target=aws_vpc_security_group_ingress_rule.vpn_client
  -target=module.sim.aws_vpc_security_group_ingress_rule.vpn_ssh
  -target=module.sim.aws_vpc_security_group_ingress_rule.vpn_signaling
  -target=module.sim.aws_vpc_security_group_ingress_rule.vpn_media
)

cmd_vpn_off() {
  load_env
  ensure_tf_ready
  require_cmd aws

  local endpoint
  endpoint="$(tf_out vpn_endpoint_id)"
  if [[ -z "${endpoint}" ]]; then
    info "nu există endpoint Client VPN în state; nu am ce șterge"
    set_env_var SIM_VPN_ENABLED false
    return 0
  fi

  info "șterg endpoint-ul ${endpoint} și regulile de tunel (instanța rămâne)"
  # Ștergerea rămâne neblocată: `launch_confirmed=true` e trimis explicit, ca precondiția din
  # `stacks/sim` să nu poată opri teardown-ul.
  tf destroy -input=false -auto-approve -var vpn_enabled=true -var launch_confirmed=true "${VPN_TARGETS[@]}" \
    || die "ștergerea VPN-ului a eșuat"
  set_env_var SIM_VPN_ENABLED false

  ok "VPN oprit: taxa orară a endpoint-ului se oprește, instanța și discul sunt neatinse."
  plain "  Revenire:  make sim-vpn-on   (certificate noi), apoi  make sim-vpn  pentru profil."
}

cmd_vpn_on() {
  load_env
  # Endpoint-ul Client VPN se taxează orar cât timp există (ADR 0004), deci recrarea lui cere
  # comutatorul; ștergerea (`vpn-off`) nu trece pe aici. Refuzul vine înainte de `terraform init`.
  require_launch_enabled "endpoint-ul Client VPN" "make sim-vpn-on   (sau ./tools/twinctl/twinctl vpn-on)"
  ensure_tf_ready
  require_cmd aws

  local existing
  existing="$(tf_out vpn_endpoint_id)"
  if [[ -n "${existing}" ]]; then
    info "endpoint-ul ${existing} există deja; nu creez al doilea"
    set_env_var SIM_VPN_ENABLED true
    return 0
  fi

  info "recreez endpoint-ul Client VPN (instanța rămâne)"
  # Țintit pe modul și pe reguli: gardul general nu intră în plan, dar primește oricum
  # confirmarea, ca intenția să fie explicită la fel ca pe celelalte căi de lansare.
  tf apply -input=false -auto-approve -var vpn_enabled=true -var launch_confirmed=true "${VPN_TARGETS[@]}" \
    || die "crearea VPN-ului a eșuat"
  set_env_var SIM_VPN_ENABLED true

  ok "VPN pornit. Certificatele de client sunt noi, deci profilul vechi nu mai e valabil."
  plain "  Profil nou:  make sim-vpn   (se scrie în ~/.cncdt/${PROJECT_NAME}-${ENVIRONMENT}-sim.ovpn)"
}

# ---------------------------------------------------------------- dcv (acces grafic)
cmd_dcv() {
  # Interfața grafică a instanței: desktop GNOME + Amazon DCV, instalate de bootstrap.
  # Portul 8443 nu este deschis public; se ajunge la el prin tunel (SSH sau Session Manager).
  local open="false" mode="auto"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --open) open="true" ;;
      --mode) mode="${2:-auto}"; shift ;;
      *) die "opțiune necunoscută pentru dcv: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready
  require_cmd aws
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  local id state ip port param password
  id="$(current_instance_id)"
  state="$(instance_state "${id}")"
  [[ "${state}" == "running" ]] || die "instanța este ${state}; rulați \`start\`"
  ip="$(instance_ip "${id}")"
  port="$(tf_out dcv_port)"
  [[ -n "${port}" && "${port}" != "null" ]] || port="${SIM_DCV_PORT:-8443}"
  # Numele parametrului vine din ieșirea Terraform; pe instanțele create înainte de introducerea
  # DCV, ieșirea lipsește din state, deci îl reconstruim din .env (aceeași schemă ca în modul).
  param="$(tf_out dcv_password_parameter)"
  if [[ -z "${param}" || "${param}" == "null" ]]; then
    param="${SIM_DCV_PASSWORD_PARAMETER:-/${PROJECT_NAME}-${ENVIRONMENT}-sim/dcv-password}"
  fi

  if [[ "${SIM_DCV_ENABLED}" != "true" ]]; then
    die "DCV este dezactivat; puneți SIM_DCV_ENABLED=true în .env și recreați instanța"
  fi

  plain ""
  printf '%s\n' "${C_BOLD}Interfață grafică (Amazon DCV)${C_RESET}"
  row "client web" "https://localhost:${port}/" 16
  row "utilizator" "ubuntu" 16

  if [[ -n "${param}" && "${param}" != "null" ]]; then
    password="$(aws_cli ssm get-parameter --name "${param}" --with-decryption \
      --query 'Parameter.Value' --output text 2>/dev/null || true)"
    if [[ -n "${password}" && "${password}" != "None" ]]; then
      row "parolă" "${password}" 16
    else
      warn "parola nu a fost găsită în ${param}; setați una cu: ./tools/twinctl/twinctl ssh sudo passwd ubuntu"
    fi
  fi

  plain ""
  plain "  ${C_BOLD}Tunel către portul ${port}${C_RESET}"
  plain "    ssh -i ${SIM_SSH_PRIVATE_KEY} -L ${port}:127.0.0.1:${port} -N ubuntu@${ip}"
  plain "    ${C_DIM}sau, fără port 22 deschis:${C_RESET}"
  plain "    aws ssm start-session --target ${id} --document-name AWS-StartPortForwardingSession \\"
  plain "      --parameters '{\"portNumber\":[\"${port}\"],\"localPortNumber\":[\"${port}\"]}'"
  plain ""

  if [[ "${open}" != "true" ]]; then
    plain "  ${C_DIM}Rulați cu --open ca să deschid tunelul în fundal.${C_RESET}"
    return 0
  fi

  case "${mode}" in
    auto) if has_ssm_plugin; then mode="ssm"; else mode="ssh"; fi ;;
    ssm|ssh) ;;
    *) die "mod necunoscut: ${mode} (folosiți auto, ssm sau ssh)" ;;
  esac

  info "deschid tunelul (${mode}) pentru portul ${port}"
  if [[ "${mode}" == "ssm" ]]; then
    start_ssm_tunnel "${id}" dcv "${port}"
  else
    start_ssh_tunnel "${ip}" dcv "${port}"
  fi
  sleep 2
  if [[ -z "$(active_tunnels)" ]]; then
    warn "tunelul nu a pornit; verificați ${TUNNEL_DIR}/*.log"
    return 1
  fi
  ok "tunel activ; deschideți https://localhost:${port}/ în browser"
  plain "  ${C_DIM}Închideți tunelurile cu: ./tools/twinctl/twinctl connect --stop${C_RESET}"
}

# ---------------------------------------------------------------- down
cmd_down() {
  local assume_yes="false" freeze="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes="true" ;;
      --freeze) freeze="true" ;;
      *) die "opțiune necunoscută pentru down: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready

  if ! state_exists; then
    ok "nu există nimic de șters"
    return 0
  fi

  local id ip
  id="$(current_instance_id)"
  ip="$(tf_out public_ip)"

  printf '%s\n' "${C_BOLD}Se vor șterge:${C_RESET}"
  row "instanță" "${id} ($(tf_out instance_type))" 24
  row "volum rădăcină" "${SIM_ROOT_VOLUME_GB} GB (se pierde tot ce e pe disc)" 24
  row "IP public (Elastic)" "${ip:-<alocat la pornire>}" 24
  row "security group" "$(tf_out security_group_id)" 24
  local key_name
  key_name="$(tf_out key_name)"
  [[ -n "${key_name}" ]] && row "cheie SSH" "${key_name}" 24
  row "log group bootstrap" "$(tf_out bootstrap_log_group)" 24
  row "rol IAM + alarmă" "create de stack-ul sim" 24
  local volume_id
  volume_id="$(tf_out data_volume_id)"
  if [[ -n "${volume_id}" ]]; then
    row "volum de date" "PĂSTRAT: ${volume_id} (se șterge doar cu \`make sim-data-down\`)" 24
  fi
  if [[ "${freeze}" == "true" ]]; then
    row "înainte de ștergere" "se creează un AMI golden (Isaac Sim rămâne instalat)" 24
  else
    row "înainte de ștergere" "fără AMI: următoarea \`up\` reinstalează Isaac Sim" 24
  fi
  plain ""

  if [[ "${assume_yes}" != "true" ]]; then
    read -r -p "Confirmați ștergerea completă? scrieți 'da': " answer
    [[ "${answer}" == "da" ]] || { warn "anulat"; return 1; }
  fi

  if [[ "${freeze}" == "true" ]]; then
    cmd_freeze || die "înghețarea a eșuat; nu șterg nimic"
  fi

  stop_tunnels >/dev/null

  local -a args=(-input=false)
  [[ "${assume_yes}" == "true" ]] && args+=(-auto-approve)
  # Teardown-ul nu depinde de comutator: confirmarea e trimisă mereu, ca precondiția din
  # `stacks/sim` să nu poată bloca ștergerea.
  args+=(-var launch_confirmed=true)
  tf destroy "${args[@]}"

  ok "resurse șterse. State-ul local rămâne gol în stacks/sim."
  plain "      asset-urile urcate în S3 rămân intacte."
  if [[ -n "${volume_id}" ]]; then
    plain "      volumul de date ${volume_id} rămâne și se reatașează la următorul \`up\`."
  fi
  plain "      recreați oricând cu: make sim-up"
}

# ---------------------------------------------------------------- dispatch
main() {
  local command="${1:-help}"
  shift || true

  case "${command}" in
    init)      load_env; cmd_init "$@" ;;
    up)        cmd_up "$@" ;;
    status)    cmd_status "$@" ;;
    url)       cmd_url "$@" ;;
    connect)   cmd_connect "$@" ;;
    dcv)       cmd_dcv "$@" ;;
    ssh)       cmd_ssh "$@" ;;
    push)      cmd_push "$@" ;;
    push-sim)  cmd_push_sim "$@" ;;
    freeze)    cmd_freeze "$@" ;;
    vpn-config) cmd_vpn_config "$@" ;;
    vpn-off)   cmd_vpn_off "$@" ;;
    vpn-on)    cmd_vpn_on "$@" ;;
    logs)      cmd_logs "$@" ;;
    start)     cmd_start "$@" ;;
    stop)      cmd_stop "$@" ;;
    selftest)  cmd_selftest "$@" ;;
    outputs)   cmd_outputs "$@" ;;
    cost)      cmd_cost "$@" ;;
    spot)      cmd_spot "$@" ;;
    data)      cmd_data "$@" ;;
    data-up)   cmd_data_up "$@" ;;
    data-down) cmd_data_down "$@" ;;
    data-snapshot)
               cmd_data_snapshot "$@" ;;
    down)      cmd_down "$@" ;;
    help|--help|-h) load_env; usage ;;
    *)         warn "comandă necunoscută: ${command}"; plain ""; load_env; usage; exit 1 ;;
  esac
}

main "$@"
