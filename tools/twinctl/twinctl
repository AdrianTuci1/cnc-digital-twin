# ---------------------------------------------------------------- tuneluri
active_tunnels() {
  local pidfile pid
  for pidfile in "${TUNNEL_DIR}"/*.pid; do
    [[ -e "${pidfile}" ]] || continue
    pid="$(cat "${pidfile}" 2>/dev/null || true)"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      printf '%s\n' "${pid}"
    else
      rm -f "${pidfile}"
    fi
  done
}

cmd_connect() {
  local mode="auto" stop="false" foreground="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode) mode="${2:-auto}"; shift ;;
      --stop) stop="true" ;;
      --foreground) foreground="true" ;;
      *) die "opțiune necunoscută pentru connect: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready

  if [[ "${stop}" == "true" ]]; then
    stop_tunnels
    return 0
  fi

  state_exists || die "nu există instanță; rulați întâi \`up\`"
  local id state ip
  id="$(current_instance_id)"
  state="$(instance_state "${id}")"
  [[ "${state}" == "running" ]] || die "instanța este ${state}; rulați \`start\`"

  ip="$(instance_ip "${id}")"

  case "${mode}" in
    auto)
      if has_ssm_plugin; then mode="ssm"; else mode="ssh"; fi
      ;;
    ssm|ssh) ;;
    *) die "mod necunoscut: ${mode} (folosiți auto, ssm sau ssh)" ;;
  esac

  if [[ "${mode}" == "ssh" ]]; then
    [[ -f "${SIM_SSH_PRIVATE_KEY}" ]] || die "cheia privată nu există: ${SIM_SSH_PRIVATE_KEY}"
    [[ -n "${SIM_SSH_KEY_NAME}${SIM_SSH_PUBLIC_KEY}" ]] || die "nu s-a configurat nicio cheie SSH"
  fi

  stop_tunnels >/dev/null

  # Doar semnalizarea se tuneluează: media WebRTC este UDP și nu trece prin port-forwarding TCP.
  info "deschid tunelul (${mode}) pentru portul de semnalizare ${ISAAC_SIGNALING_PORT}"

  if [[ "${mode}" == "ssm" ]]; then
    start_ssm_tunnel "${id}" signaling "${ISAAC_SIGNALING_PORT}"
  else
    start_ssh_tunnel "${ip}" signaling "${ISAAC_SIGNALING_PORT}"
  fi

  sleep 2
  if [[ -z "$(active_tunnels)" ]]; then
    warn "tunelul nu a pornit; verificați ${TUNNEL_DIR}/*.log"
    return 1
  fi
  ok "tunel activ (PID: $(active_tunnels | tr '\n' ' '))"

  local url
  url="$(tf_out webrtc_url)"
  plain ""
  printf '%s\n' "${C_BOLD}Server pentru clientul Isaac Sim WebRTC Streaming Client:${C_RESET} ${url}"
  plain ""
  plain "${C_DIM}Note:${C_RESET}"
  plain "  • Isaac Sim 5.0 nu mai servește pagina /streaming/webrtc-client; folosiți aplicația"
  plain "    nativă „Isaac Sim WebRTC Streaming Client\" (Windows/macOS/Linux), din pagina de"
  plain "    download Isaac Sim."
  plain "  • Aplicația Isaac Sim trebuie să fie pornită:  ./tools/twinctl/twinctl ssh /opt/cncdt/scripts/start-isaac.sh"
  plain "  • Tunelul acoperă doar semnalizarea (TCP). Media WebRTC este UDP (${ISAAC_MEDIA_PORT_RANGE:-47998-48020})"
  plain "    și trebuie să ajungă direct la instanță, nu prin 127.0.0.1; IP-ul clientului"
  plain "    trebuie să fie în SIM_SSH_ALLOWED_CIDRS."
  plain "  • Închideți tunelul cu: ./tools/twinctl/twinctl connect --stop"

  [[ "${foreground}" == "true" ]] && wait
}

start_ssm_tunnel() {
  local id="$1" tag="$2" port="$3"
  local log="${TUNNEL_DIR}/ssm-${tag}-${port}.log"
  nohup aws ssm start-session \
    --region "${AWS_REGION}" --profile "${AWS_PROFILE}" \
    --target "${id}" \
    --document-name AWS-StartPortForwardingSession \
    --parameters "{\"portNumber\":[\"${port}\"],\"localPortNumber\":[\"${port}\"]}" \
    >"${log}" 2>&1 &
  printf '%s\n' "$!" > "${TUNNEL_DIR}/ssm-${tag}-${port}.pid"
}

start_ssh_tunnel() {
  local ip="$1" tag="$2"; shift 2
  local -a forwards=()
  local port
  for port in "$@"; do
    forwards+=(-L "${port}:127.0.0.1:${port}")
  done
  local log="${TUNNEL_DIR}/ssh-${tag}.log"
  nohup ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
    -o StrictHostKeyChecking=accept-new \
    -i "${SIM_SSH_PRIVATE_KEY}" "${forwards[@]}" "ubuntu@${ip}" \
    >"${log}" 2>&1 &
  printf '%s\n' "$!" > "${TUNNEL_DIR}/ssh-${tag}.pid"
}

stop_tunnels() {
  local pidfile pid stopped=0
  for pidfile in "${TUNNEL_DIR}"/*.pid; do
    [[ -e "${pidfile}" ]] || continue
    pid="$(cat "${pidfile}" 2>/dev/null || true)"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
      stopped=$(( stopped + 1 ))
    fi
    rm -f "${pidfile}"
  done
  if [[ "${stopped}" -gt 0 ]]; then
    ok "am închis ${stopped} tunel(uri)"
  else
    ok "niciun tunel activ"
  fi
}

