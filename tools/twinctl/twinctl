# ---------------------------------------------------------------- push
cmd_push() {
  load_env
  ensure_tf_ready
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  local id
  id="$(current_instance_id)"

  local bucket="${SIM_ASSETS_BUCKET}"
  if [[ -z "${bucket}" ]]; then
    bucket="$(aws_cli s3api list-buckets \
      --query "Buckets[?starts_with(Name, '${PROJECT_NAME}-${ENVIRONMENT}-assets-')].Name | [0]" \
      --output text 2>/dev/null || true)"
  fi
  [[ -n "${bucket}" && "${bucket}" != "None" ]] \
    || die "nu am găsit bucket-ul de asset-uri; rulați \`make platform-up\` sau setați SIM_ASSETS_BUCKET"

  local staging="${STATE_DIR}/staging"
  rm -rf "${staging}"
  mkdir -p "${staging}/repo"

  info "pregătesc pachetul din simulation/"
  tar --exclude='assets/*.usd*' --exclude='__pycache__' --exclude='logs' \
    -czf "${staging}/simulation.tgz" -C "${ROOT}" simulation

  local asset_count=0
  if compgen -G "${ROOT}/simulation/assets/*" >/dev/null; then
    asset_count="$(find "${ROOT}/simulation/assets" -type f | wc -l | tr -d ' ')"
  fi

  info "urc în s3://${bucket}/sim-assets/latest/"
  aws_cli s3 cp "${staging}/simulation.tgz" \
    "s3://${bucket}/sim-assets/latest/simulation.tgz" --only-show-errors
  if [[ "${asset_count}" -gt 0 ]]; then
    aws_cli s3 sync "${ROOT}/simulation/assets/" "s3://${bucket}/sim-assets/latest/assets/" \
      --only-show-errors
    ok "am urcat ${asset_count} fișiere de asset-uri"
  fi

  info "despachetez pe instanță prin SSM"
  local command
  command="set -e
mkdir -p /opt/cncdt/simulation
aws s3 cp s3://${bucket}/sim-assets/latest/simulation.tgz /tmp/simulation.tgz --region ${AWS_REGION}
tar -xzf /tmp/simulation.tgz -C /tmp
rm -rf /opt/cncdt/simulation
mv /tmp/simulation /opt/cncdt/simulation
mkdir -p /opt/cncdt/assets
if aws s3 ls s3://${bucket}/sim-assets/latest/assets/ --region ${AWS_REGION} >/dev/null 2>&1; then
  aws s3 sync s3://${bucket}/sim-assets/latest/assets/ /opt/cncdt/assets/ --only-show-errors --region ${AWS_REGION}
fi
chown -R ubuntu:ubuntu /opt/cncdt/simulation /opt/cncdt/assets
echo 'sync complet'"

  ssm_command "${id}" "${command}" 300 || warn "sincronizarea prin SSM a eșuat parțial"
  ok "simulation/ este pe instanță în /opt/cncdt/simulation"
  rm -rf "${staging}"
}

# ---------------------------------------------------------------- logs
cmd_logs() {
  local follow="false" bootstrap="false" tail_lines="120"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow="true" ;;
      --bootstrap) bootstrap="true" ;;
      --tail) tail_lines="${2:-120}"; shift ;;
      *) die "opțiune necunoscută pentru logs: $1" ;;
    esac
    shift
  done

  load_env
  ensure_tf_ready
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  local id
  id="$(current_instance_id)"

  local target
  if [[ "${bootstrap}" == "true" ]]; then
    target="/var/log/cncdt-bootstrap.log"
  else
    target="/opt/cncdt/logs"
  fi

  if [[ "${follow}" == "true" ]] && has_ssm_plugin; then
    local command
    if [[ "${bootstrap}" == "true" ]]; then
      command="tail -n ${tail_lines} -f ${target}"
    else
      command="docker logs -f --tail ${tail_lines} isaac-sim 2>&1 || tail -n ${tail_lines} -f ${target}/*.log"
    fi
    info "sesiune interactivă (Ctrl+C pentru a ieși)"
    aws_cli ssm start-session --target "${id}" \
      --document-name AWS-StartInteractiveCommand \
      --parameters "{\"command\":[\"${command}\"]}"
    return $?
  fi

  if [[ "${bootstrap}" == "true" ]]; then
    ssm_command "${id}" "tail -n ${tail_lines} ${target}" 120
  else
    ssm_command "${id}" "docker logs --tail ${tail_lines} isaac-sim 2>&1 || ls -la ${target}" 120
  fi
}

# ---------------------------------------------------------------- start / stop
cmd_start() {
  load_env
  # Repornirea unei instanțe oprite readuce costul de GPU, deci trece prin comutator. Oprirea
  # (`stop`) nu trece pe aici: reduce costul. Refuzul e local, înainte de `terraform init` și de
  # orice apel la AWS.
  require_launch_enabled "pornirea instanței GPU" "make sim-start   (sau ./tools/twinctl/twinctl start)"
  ensure_tf_ready
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  local id
  id="$(current_instance_id)"
  local state
  state="$(instance_state "${id}")"

  if [[ "${state}" == "running" ]]; then
    ok "instanța rulează deja"
    return 0
  fi

  if [[ "${state}" == "terminated" || "${state}" == "shutting-down" ]]; then
    die "instanța ${id} a fost terminată (cerere spot \`one-time\`); porniți alta cu \`make sim-up\` — volumul de date se reatașează singur"
  fi

  info "pornesc instanța ${id}"
  aws_cli ec2 start-instances --instance-ids "${id}" >/dev/null
  wait_for_state "${id}" "running" 40 || die "instanța nu a ajuns în starea running"

  ok "instanța rulează"
  if [[ "$(instance_market "${id}")" == "on-demand" && "${SIM_USE_SPOT}" == "true" ]]; then
    warn "instanța ${id} nu rulează pe spot (a fost creată cu SIM_USE_SPOT=false)"
    plain "      \`make sim-down\` urmat de \`make sim-up\` o recreează pe spot."
  fi
  print_connection_info "${id}"
  plain ""
  plain "  Containerul Isaac Sim pornește automat la boot dacă SIM_AUTOSTART=true."
  plain "  Altfel: ./tools/twinctl/twinctl ssh /opt/cncdt/scripts/start-isaac.sh"
}

cmd_stop() {
  [[ $# -eq 0 ]] || die "comanda stop nu primește opțiuni: $1"

  # Deliberat neblocat: oprirea reduce costul, iar gardul acoperă doar ce cheltuiește în plus.
  load_env
  ensure_tf_ready
  state_exists || die "nu există instanță; rulați întâi \`up\`"

  stop_tunnels >/dev/null

  local id
  id="$(current_instance_id)"
  local state market
  state="$(instance_state "${id}")"
  market="$(instance_market "${id}")"

  if [[ "${state}" != "running" ]]; then
    ok "instanța este deja ${state}"
    return 0
  fi

  # AWS acceptă oprirea doar pentru cererile spot `persistent`, iar a noastră este `one-time`:
  # API-ul refuză oprirea. Pauza care funcționează pe spot este terminarea, iar volumul de date
  # rămâne în stack-ul lui și se reatașează la următorul `up`.
  if [[ "${market}" == "spot" ]]; then
    warn "instanța rulează pe spot cu cerere \`one-time\`: AWS permite terminarea, nu oprirea"
    plain "      pentru o pauză: ./tools/twinctl/twinctl down   (instanța se șterge, volumul rămâne)"
    plain "      reluarea:        make sim-up                  (instanță nouă, același volum reatașat)"
    return 1
  fi

  info "opresc instanța ${id} (discul rămâne, costul de GPU se oprește)"
  aws_cli ec2 stop-instances --instance-ids "${id}" >/dev/null
  wait_for_state "${id}" "stopped" 60 || warn "instanța nu a confirmat oprirea în 5 minute"
  ok "instanță oprită. Reluați cu \`start\`, ștergeți cu \`down\`."
  plain "      cost estimat în repaus: ~$(awk -v gb="${SIM_ROOT_VOLUME_GB}" -v p="${EBS_GP3_GB_MONTH}" 'BEGIN { printf "%.2f", gb * p / 30 / 24 }') USD/h (EBS gp3)"
}

